---
import MainLayout from "../layouts/MainLayout.astro";
import PartnerDisclosure from "../components/PartnerDisclosure.astro";
import SanctuaryCta from "../components/SanctuaryCta.astro";
---

<MainLayout
  title="Free Career Guidance"
  description="Free, student-first career counselling for academic choices, career paths, coaching options, and overseas education at NPconscious."
>
  <!-- Hero Section -->
  <section class="surface-beige px-5 pt-14 pb-16 sm:pt-20 sm:pb-20 lg:px-8 lg:pt-24 lg:pb-24">
    <div class="container-nav">
      <div class="mx-auto max-w-3xl text-center space-y-6">
        <h1 class="display-h1" data-hero-reveal>
          Free Career &amp; Academic Guidance
        </h1>

        <p class="mx-auto max-w-2xl text-base sm:text-lg leading-relaxed text-[var(--text-secondary)]" data-hero-reveal>
          A listen-first space for students and parents to explore academic choices, career directions, coaching options, and overseas education with <strong class="font-semibold text-[var(--text-primary)]">zero counselling charges</strong>.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-2" data-hero-reveal>
          <a href="/admission?interest=career-guidance" class="btn-pill-sage w-full sm:w-auto">
            <span>Book a Free Guidance Session</span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="https://wa.me/918011236456?text=Hi%20NPconscious%20team%2C%20I%27d%20like%20to%20book%20a%20free%20career%20guidance%20session."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-pill-secondary w-full sm:w-auto"
          >
            <span>Message on WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Help Explore (White Surface) -->
  <section class="surface-white section-pad border-y border-[var(--border-subtle)]">
    <div class="container-feature space-y-12">
      <div class="max-w-2xl space-y-3">
        <h2 class="section-h2">Conversations Around Your Goals</h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
          You do not need to know what to ask before reaching out. We start by understanding the student's interests, strengths, constraints, and questions.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <article class="border-t border-[var(--border-strong)] pt-5 space-y-2">
          <h3 class="text-base font-semibold text-[var(--text-primary)]">Academic &amp; Stream Choices</h3>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            Subject selection, school-to-college transitions, and degree options aligned with the student's interests.
          </p>
        </article>

        <article class="border-t border-[var(--border-strong)] pt-5 space-y-2">
          <h3 class="text-base font-semibold text-[var(--text-primary)]">Career Paths &amp; Roadmaps</h3>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            Exploring practical skill paths, higher studies, and quantitative or technical fields without hype.
          </p>
        </article>

        <article class="border-t border-[var(--border-strong)] pt-5 space-y-2">
          <h3 class="text-base font-semibold text-[var(--text-primary)]">Coaching Options</h3>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            Evaluating whether coaching is needed at your stage and comparing options against your budget.
          </p>
        </article>

        <article class="border-t border-[var(--border-strong)] pt-5 space-y-2">
          <h3 class="text-base font-semibold text-[var(--text-primary)]">Overseas Education</h3>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            Comparing study-abroad pathways realistically against eligibility, timelines, and family budget.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Listen-First Process & Referral Disclosure (Beige Surface) -->
  <section class="surface-beige section-pad">
    <div class="container-reading space-y-12">
      <div class="space-y-3">
        <h2 class="section-h2">How Free Counselling Works</h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)]">
          Share where you are right now, and we will arrange a listen-first conversation at a convenient time.
        </p>
      </div>

      <ol class="grid gap-8 border-t border-[var(--border-subtle)] pt-8 md:grid-cols-3">
        <li class="space-y-2">
          <span class="text-sm font-semibold text-[var(--accent-sage)] tabular-nums">01</span>
          <h3 class="text-base font-semibold text-[var(--text-primary)]">Listen &amp; Understand</h3>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            We listen to the student's current stage, goals, eligibility, budget, and preferences.
          </p>
        </li>

        <li class="space-y-2">
          <span class="text-sm font-semibold text-[var(--accent-sage)] tabular-nums">02</span>
          <h3 class="text-base font-semibold text-[var(--text-primary)]">Map Clear Options</h3>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            We lay out realistic pathways directly, never promising admissions, visas, jobs, or exam scores outside our control.
          </p>
        </li>

        <li class="space-y-2">
          <span class="text-sm font-semibold text-[var(--accent-sage)] tabular-nums">03</span>
          <h3 class="text-base font-semibold text-[var(--text-primary)]">Choose Only What Fits</h3>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            If helpful, we point to relevant NPconscious learning or a vetted external partner with zero obligation.
          </p>
        </li>
      </ol>

      <!-- Mandatory Plain-Language Referral & Commission Disclosure -->
      <PartnerDisclosure variant="card" />
    </div>
  </section>

  <!-- Optional Cross-Links ("If Relevant") -->
  <section class="surface-white section-pad border-t border-[var(--border-subtle)]">
    <div class="container-reading space-y-8">
      <div class="space-y-2">
        <h2 class="section-h2">Learning Support When It Helps Your Plan</h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)]">
          Many students come solely for free Career Guidance. If your plan calls for stronger academic skills, you can explore these options when relevant.
        </p>
      </div>
      <div class="grid gap-8 border-t border-[var(--border-subtle)] pt-8 sm:grid-cols-2">
        <a href="/mathematics" class="group block space-y-1.5">
          <span class="text-xs font-semibold text-[var(--text-muted)]">If Relevant</span>
          <h3 class="text-lg font-semibold text-[var(--text-primary)] group-hover:underline">Mathematics Mentorship →</h3>
          <p class="text-sm text-[var(--text-secondary)]">Strengthen fundamentals for boards, STEM entrances, finance, or university engineering.</p>
        </a>
        <a href="/computer-science" class="group block space-y-1.5">
          <span class="text-xs font-semibold text-[var(--text-muted)]">If Relevant</span>
          <h3 class="text-lg font-semibold text-[var(--text-primary)] group-hover:underline">Computer Science →</h3>
          <p class="text-sm text-[var(--text-secondary)]">Explore Python fundamentals, web basics, and logical problem-solving pathways.</p>
        </a>
      </div>
    </div>
  </section>

  <SanctuaryCta
    heading="Not Sure What to Ask Yet? Start With a Free Conversation"
    description="Basic career counselling at NPconscious is always free. Tell us where you are right now and let us explore your options together."
    primaryLabel="Book Free Guidance on WhatsApp"
    primaryHref="https://wa.me/918011236456?text=Hi%20NPconscious%20team%2C%20I%27d%20like%20to%20book%20a%20free%20career%20guidance%20session."
    secondaryLabel="Schedule via Intake Form"
    secondaryHref="/admission?interest=career-guidance"
  />
</MainLayout>
