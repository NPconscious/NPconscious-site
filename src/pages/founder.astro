---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Our Vision & Philosophy">
  <!-- Hero Section: Editorial & Warm -->
  <section class="relative overflow-hidden bg-hero-texture px-4 pt-8 pb-14 sm:px-6 sm:pt-14 sm:pb-20 lg:px-8 lg:pt-16 lg:pb-24">
    <div class="mx-auto max-w-[1360px]">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <!-- Left Hero Content -->
        <div class="space-y-6 lg:col-span-7">
          <!-- Text block with blended Thinkers artwork backdrop -->
          <div id="founder-hero-container" class="relative">
            <!-- Blended Thinkers Image Backdrop: starts horizontally from 'k' in Thinkers, covers half of up/down text -->
            <div 
              id="founder-thinkers-backdrop"
              class="pointer-events-none absolute select-none z-0 left-[48%] sm:left-[49%] lg:left-[48%] -top-2 sm:-top-4 bottom-0 sm:bottom-1 w-[260px] sm:w-[340px] lg:w-[410px] aspect-square max-w-[420px]"
              aria-hidden="true"
            >
              <!-- Outer fade on left to smoothly start from 'k' -->
              <div 
                class="w-full h-full relative"
                style="
                  -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 8%, black 20%, black 100%);
                  mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 8%, black 20%, black 100%);
                "
              >
                <!-- Inner circular mask to feather edges and eliminate black corners -->
                <div 
                  class="w-full h-full relative"
                  style="
                    -webkit-mask-image: radial-gradient(circle at center, rgba(0,0,0,1) 36%, rgba(0,0,0,0.7) 44%, transparent 48.5%);
                    mask-image: radial-gradient(circle at center, rgba(0,0,0,1) 36%, rgba(0,0,0,0.7) 44%, transparent 48.5%);
                  "
                >
                  <!-- Kid Thinker Illustration -->
                  <img 
                    src="/building-thinkers.jpg" 
                    alt="" 
                    class="w-full h-full object-cover object-center opacity-85 contrast-[1.05] saturate-[1.1]"
                    loading="eager"
                    decoding="async"
                  />
                  <!-- Soft Warm Ambient Scrims to harmonize with #FAF8F5 background -->
                  <div class="absolute inset-0 bg-gradient-to-r from-[#FAF8F5]/85 via-[#FAF8F5]/25 to-transparent pointer-events-none"></div>
                  <div class="absolute inset-0 bg-gradient-to-b from-[#FAF8F5]/35 via-transparent to-[#FAF8F5]/45 pointer-events-none"></div>
                </div>
              </div>
            </div>

            <!-- Foreground Content: crisp typography elevated on top of image -->
            <div class="relative z-10 space-y-6">
              <div class="inline-flex items-center gap-2 rounded-full border border-amber-300/80 bg-amber-50/90 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-amber-900 shadow-xs backdrop-blur-sm">
                <span class="flex h-2 w-2 rounded-full bg-amber-500"></span>
                <span>Founder & Mentorship Philosophy</span>
              </div>

              <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl leading-[1.12] text-layer-elevated" style="text-shadow: 0 1px 3px rgba(250, 248, 245, 0.95), 0 0 20px rgba(250, 248, 245, 0.9);">
                Building Thin<span id="thinker-k-marker">k</span>ers,<br />
                <span class="text-amber-600">Not Just Test-Takers</span>
              </h1>

              <p class="max-w-2xl text-base sm:text-lg leading-relaxed text-slate-700 font-medium text-layer-elevated" style="text-shadow: 0 1px 3px rgba(250, 248, 245, 0.95), 0 0 20px rgba(250, 248, 245, 0.9);">
                At NPconscious, we believe mathematics is not a set of rigid formulas to be memorized under stress — it is the natural, universal language of patterns, geometry, and creative logic.
              </p>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-1">
            <a
              href="https://wa.me/918088276492?text=Hi%20Nikhil%2C%20I%20would%20love%20to%20connect%20and%20learn%20more%20about%20NPconscious."
              class="inline-flex items-center justify-center gap-2 rounded-full bg-amber-600 hover:bg-amber-700 px-7 py-3.5 text-sm font-semibold text-white shadow-soft transition-all hover:shadow-hover hover:-translate-y-0.5 active:translate-y-0"
            >
              <span>Connect with Founder</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
            <a
              href="mailto:npconscious@gmail.com"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-300 bg-white px-7 py-3.5 text-sm font-semibold text-slate-800 shadow-xs transition hover:bg-slate-50"
            >
              <span>Email Nikhil Directly</span>
            </a>
          </div>

          <!-- Academic & Professional Credential Chips -->
          <div class="flex flex-wrap items-center gap-2.5 pt-2 text-xs font-semibold text-slate-700">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 border border-slate-200/90 shadow-xs">
              <svg class="h-3.5 w-3.5 text-amber-600" fill="currentColor" viewBox="0 0 20 20"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a10.973 10.973 0 00-.25 2.302c0 2.502.99 4.812 2.625 6.467A1 1 0 008.5 17h3a1 1 0 00.875-1.18 10.974 10.974 0 002.625-6.467c0-.79-.088-1.564-.25-2.302l2.644-1.13a1 1 0 000-1.84l-7-3z"/></svg>
              Information Science Engineer
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 border border-slate-200/90 shadow-xs">
              <svg class="h-3.5 w-3.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              Ex-Bhanzu, Airbnb, Concentrix
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 border border-slate-200/90 shadow-xs">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              100% Student-First Vision
            </span>
          </div>
        </div>

        <!-- Right Hero Visual -->
        <div class="relative lg:col-span-5">
          <div class="relative rounded-3xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-soft">
            <div class="overflow-hidden rounded-2xl bg-slate-50 border border-slate-100">
              <img
                src="/vision.webp"
                alt="NPconscious learner-focused vision"
                class="w-full h-auto object-cover"
              />
            </div>
            <div class="mt-4 flex items-center justify-between text-xs font-medium text-slate-600 border-t border-slate-100 pt-3">
              <span class="inline-flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                Curiosity Over Rote Drills
              </span>
              <span class="text-amber-800 font-semibold">Every child can master math</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The "Conscious Mathematics" Manifesto -->
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8 bg-white border-y border-slate-200/80">
    <div class="mx-auto max-w-4xl space-y-10">
      <div class="text-center space-y-3">
        <span class="inline-block rounded-full bg-slate-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-slate-700">
          Educational Manifesto
        </span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Why "Conscious" Mathematics?
        </h2>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600">
          When we teach mathematics unconsciously, we reduce it to memorizing steps for an exam. When we teach it consciously, it becomes a superpower.
        </p>
      </div>

      <div class="space-y-6 text-sm sm:text-base leading-relaxed text-slate-700">
        <div class="rounded-3xl border border-slate-200/80 bg-[#FAF8F5] p-6 sm:p-8 space-y-3 shadow-xs">
          <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span class="text-amber-600">01.</span> The Real Source of Math Fear
          </h3>
          <p>
            Children don't hate mathematics; they hate feeling confused and judged. When a child is handed a formula like the quadratic equation or trigonometric identities without discovering <em>why</em> they work, their brain treats it as an arbitrary burden. If they forget one plus sign, they fail. That pressure creates anxiety that lasts into adulthood.
          </p>
        </div>

        <div class="rounded-3xl border border-slate-200/80 bg-[#FAF8F5] p-6 sm:p-8 space-y-3 shadow-xs">
          <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span class="text-amber-600">02.</span> Visual Models Before Algebraic Symbols
          </h3>
          <p>
            Human beings are visual pattern recognizers. In every NPconscious class, we translate abstract algebra into geometric structures and tangible physical analogies. Once a student can <em>see</em> what an equation is doing, writing the symbols down is merely documenting what their intuition has already understood.
          </p>
        </div>

        <div class="rounded-3xl border border-slate-200/80 bg-[#FAF8F5] p-6 sm:p-8 space-y-3 shadow-xs">
          <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span class="text-amber-600">03.</span> Emotional Safety in the Classroom
          </h3>
          <p>
            No student ever learned deeply while feeling humiliated or rushed. Our mentors are trained to celebrate wrong answers as fascinating windows into how a student's mind is reasoning. By breaking the stigma of "getting it wrong," we unlock the courage to tackle challenging, unfamiliar STEM problems.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Mentorship Pillars -->
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8 bg-[#FAF8F5]">
    <div class="mx-auto max-w-6xl space-y-12">
      <div class="text-center space-y-3">
        <span class="inline-block rounded-full bg-amber-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-amber-900 border border-amber-200">
          Our Guiding Pillars
        </span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Mathematics Has No Age Limit
        </h2>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600">
          From a 6-year-old learning the rhythm of numbers to a high schooler tackling calculus or an adult mastering compounding finance.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-3xl border border-slate-200/90 bg-white p-7 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-800 font-bold mb-5">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">Curiosity Over Speed</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-slate-600">
            Speed comes naturally once concepts are understood. We never rush a child through timed drills before their foundational intuition is secure.
          </p>
        </div>

        <div class="rounded-3xl border border-slate-200/90 bg-white p-7 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-700 font-bold mb-5">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">1-on-1 Patient Mentorship</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-slate-600">
            Every learner thinks at a unique cognitive cadence. Our mentors adapt their explanations in real time to match how your child makes connections.
          </p>
        </div>

        <div class="rounded-3xl border border-slate-200/90 bg-white p-7 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-800 font-bold mb-5">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">Concepts That Never Expire</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-slate-600">
            We build permanent intellectual assets. When a learner genuinely understands why a theorem works, that logic stays with them through high school, college, and career.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- A Personal Letter from the Founder -->
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8 bg-white border-t border-slate-200/80">
    <div class="mx-auto max-w-4xl rounded-3xl border border-amber-200/90 bg-[#FAF8F5] p-6 sm:p-12 shadow-soft">
      <div class="space-y-6">
        <span class="inline-block rounded-full bg-amber-100 px-3.5 py-1 text-xs font-semibold text-amber-900">
          A Personal Note from Nikhil
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-950">
          "Why I Started NPconscious"
        </h2>
        <div class="space-y-4 text-sm sm:text-base leading-relaxed text-slate-700">
          <p>
            Throughout school and college, I observed brilliant students lose their spark simply because mathematics was presented as an unforgiving gauntlet of rules and timed drills. The beauty of reasoning was lost under the weight of memorization.
          </p>
          <p>
            After working across top tech and education organizations like Bhanzu, Airbnb, and Concentrix, I realized that true learning happens when a student feels emotionally safe to say: "I don’t understand this yet — can we look at it another way?"
          </p>
          <p>
            That is why NPconscious was born in January 2026. Here, we celebrate the questions as much as the answers. We want our students to walk out of every session with their eyes wide open, excited to look at the world mathematically.
          </p>
        </div>

        <div class="pt-6 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <p class="font-bold text-slate-900 text-base">Nikhil Parag</p>
            <p class="text-xs text-slate-500">Founder & Academic Director, NPconscious</p>
          </div>
          <a
            href="https://wa.me/918088276492?text=Hi%20Nikhil%2C%20I%20read%20your%20letter%20on%20the%20NPconscious%20site%20and%20would%20love%20to%20connect."
            class="inline-flex items-center gap-2 rounded-full bg-slate-900 hover:bg-slate-800 px-5 py-3 text-xs font-semibold text-white transition"
          >
            <span>Message Nikhil Directly on WhatsApp</span>
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final Call to Action -->
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8 bg-[#FAF8F5]">
    <div class="mx-auto max-w-5xl rounded-3xl bg-slate-900 p-8 sm:p-14 text-center text-white shadow-2xl">
      <h2 class="text-2xl font-bold tracking-tight sm:text-4xl">
        Experience the Joy of Natural Mathematics
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-sm sm:text-base text-slate-300 leading-relaxed">
        Join our growing family of confident, curious young thinkers. Schedule a free 30-minute assessment session with our academic mentors today.
      </p>
      <div class="pt-6 flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <a
          href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20a%20free%20demo%20session!"
          class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-full bg-amber-600 hover:bg-amber-700 px-8 py-4 text-sm font-semibold text-white shadow-soft transition-all hover:shadow-hover hover:-translate-y-0.5"
        >
          <span>Book Free Demo on WhatsApp</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
        <a
          href="/admission"
          class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-full border border-slate-700 bg-white/5 hover:bg-white/10 px-7 py-4 text-sm font-semibold text-white transition"
        >
          <span>View Admission & Assessment</span>
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    function alignThinkersImage() {
      const marker = document.getElementById('thinker-k-marker');
      const backdrop = document.getElementById('founder-thinkers-backdrop');
      const container = document.getElementById('founder-hero-container');
      if (marker && backdrop && container) {
        const markerRect = marker.getBoundingClientRect();
        const containerRect = container.getBoundingClientRect();
        const leftOffset = markerRect.left - containerRect.left;
        backdrop.style.left = `${Math.round(leftOffset)}px`;
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', alignThinkersImage);
    } else {
      alignThinkersImage();
    }
    window.addEventListener('resize', alignThinkersImage);
    document.addEventListener('astro:page-load', alignThinkersImage);
  </script>
</MainLayout>
