---
import MainLayout from "../layouts/MainLayout.astro";
import SanctuaryCta from "../components/SanctuaryCta.astro";
import ComputerScienceSection from "../components/ComputerScienceSection.astro";

const reviews = [
  {
    name: "Sarra",
    role: "Parent of Grade 8 Student",
    quote:
      "My son in Grade 8 used to freeze whenever a word problem appeared. After 2 months with NPconscious, he has started explaining proofs to us at dinner! The difference in his confidence is remarkable.",
  },
  {
    name: "Maaz",
    role: "Grade 10 Learner",
    quote:
      "The Money & Mathematics module opened my eyes. I never realized how practical compound interest and probability are in real life. The classes feel like interactive discussions, not lectures.",
  },
  {
    name: "Rohit",
    role: "Parent of Grade 9 Student",
    quote:
      "I appreciate how transparent Nikhil and the educators are. No false promises of 100/100 in two days. They focus purely on conceptual fundamentals and the exam confidence naturally follows.",
  },
];

// Seamless 6-slot circular deck (3 primary reviews + 3 aria-hidden wrap clones, matching Brilliant's sliding carousel pattern)
const carouselSlides = [
  ...reviews.map((r, i) => ({ ...r, logicalIndex: i, isClone: false })),
  ...reviews.map((r, i) => ({ ...r, logicalIndex: i, isClone: true })),
];
---

<MainLayout
  title="A Sanctuary for Young Minds"
  description="NPconscious is a student-friendly sanctuary for young minds offering Mathematics, Computer Science, and free Career Guidance, listening first to help every learner find their right next step."
>
  <!-- Band 1: Umbrella Identity Hero (Warm Beige Canvas) -->
  <section class="surface-beige px-5 pt-14 pb-16 sm:pt-20 sm:pb-24 lg:px-8 lg:min-h-[calc(100svh_-_71px)] lg:flex lg:items-center">
    <div class="container-nav">
      <div class="mx-auto max-w-3xl text-center space-y-7">
        <h1 class="display-h1 text-[var(--text-primary)]" data-hero-reveal>
          NPconscious —<br class="hidden sm:inline" />
          A Sanctuary for Young Minds
        </h1>

        <p
          class="mx-auto max-w-2xl text-base sm:text-lg leading-relaxed text-[var(--text-secondary)]"
          data-hero-reveal
        >
          We listen first, understand what each student needs, and support them through
          <strong class="font-semibold text-[var(--text-primary)]">Mathematics</strong>,
          <strong class="font-semibold text-[var(--text-primary)]">Computer Science</strong>, and
          <strong class="font-semibold text-[var(--text-primary)]">free Career Guidance</strong> without pressure or rigid tracks.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-1" data-hero-reveal>
          <a href="/admission" class="btn-pill-primary w-full sm:w-auto">
            <span>Talk to Us — Free First Step</span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="#not-sure-yet" class="btn-pill-secondary w-full sm:w-auto">
            <span>Not sure yet? Start here</span>
            <svg class="h-4 w-4 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <dl
          class="mx-auto mt-10 grid max-w-3xl grid-cols-1 gap-4 border-t border-[var(--border-subtle)] pt-7 text-left sm:grid-cols-3 sm:gap-8 sm:text-center"
          data-hero-reveal
        >
          <div>
            <dt class="text-sm font-semibold text-[var(--text-primary)]">1-on-1 &amp; Small Groups</dt>
            <dd class="mt-1 text-xs text-[var(--text-muted)]">Across CBSE, ICSE, IGCSE, IB &amp; B.Tech</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-[var(--accent-sage)]">Free Career Counselling</dt>
            <dd class="mt-1 text-xs text-[var(--text-muted)]">Zero charges for basic guidance</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-[var(--text-primary)]">Listen-First Intake</dt>
            <dd class="mt-1 text-xs text-[var(--text-muted)]">Arrive even without a fixed plan</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Band 2: Three Clear Offerings (Alternating 2-Column Visual Split Rows) -->
  <section id="offerings" class="surface-white section-pad scroll-mt-24 border-y border-[var(--border-subtle)]">
    <div class="container-feature">
      <div class="max-w-2xl space-y-3 pb-10 sm:pb-14 border-b border-[var(--border-subtle)]" data-reveal>
        <h2 class="section-h2">Three Clear Ways We Support Students</h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
          Every learner enters with different questions. Explore the offering that fits where you are right now.
        </p>
      </div>

      <!-- Row 1: Mathematics (Visual Left, Copy Right) -->
      <div class="grid gap-10 py-14 sm:py-20 lg:grid-cols-12 lg:items-center lg:gap-16 border-b border-[var(--border-subtle)]">
        <div class="lg:col-span-6" data-reveal>
          <div class="rounded-[28px] border border-[var(--border-subtle)] bg-[var(--bg-secondary)] p-6 sm:p-8">
            <div class="rounded-2xl border border-[var(--border-subtle)] bg-white p-5 sm:p-6 shadow-[var(--shadow-subtle)] space-y-4">
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                  Visual Intuition Preview
                </span>
                <div class="inline-flex rounded-full border border-[var(--border-subtle)] bg-[var(--bg-elevated-soft)] p-0.5 text-[11px] font-semibold" role="tablist" aria-label="Square identity explanation mode">
                  <button
                    type="button"
                    id="math-preview-visual-btn"
                    role="tab"
                    aria-selected="true"
                    class="rounded-full bg-white px-3 py-1 text-[var(--text-primary)] shadow-[var(--shadow-subtle)] cursor-pointer transition"
                  >
                    See It
                  </button>
                  <button
                    type="button"
                    id="math-preview-rule-btn"
                    role="tab"
                    aria-selected="false"
                    class="rounded-full px-3 py-1 text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer transition"
                  >
                    Memorize
                  </button>
                </div>
              </div>

              <p class="text-base font-semibold text-[var(--text-primary)]">
                Why does <span class="font-mono bg-[var(--bg-sand-soft)] px-1.5 py-0.5 rounded">(a + b)² = a² + 2ab + b²</span>?
              </p>

              <!-- Visual Geometric Proof -->
              <div id="math-preview-visual" class="grid grid-cols-12 gap-4 items-center pt-1">
                <div class="col-span-5">
                  <svg viewBox="0 0 120 120" class="w-full max-w-[140px] mx-auto" role="img" aria-label="Geometric area model of (a + b) squared showing a squared, two a-b rectangles, and b squared">
                    <!-- a^2 -->
                    <rect x="4" y="4" width="72" height="72" rx="6" fill="#ECE5D8" stroke="#CFC7BA" stroke-width="1.5" />
                    <text x="40" y="45" text-anchor="middle" font-size="14" font-weight="600" fill="#141414">a²</text>
                    <!-- a*b right -->
                    <rect x="80" y="4" width="36" height="72" rx="6" fill="#E7F2EC" stroke="#B7D6C6" stroke-width="1.5" />
                    <text x="98" y="44" text-anchor="middle" font-size="12" font-weight="600" fill="#2F6B55">ab</text>
                    <!-- a*b bottom -->
                    <rect x="4" y="80" width="72" height="36" rx="6" fill="#E7F2EC" stroke="#B7D6C6" stroke-width="1.5" />
                    <text x="40" y="102" text-anchor="middle" font-size="12" font-weight="600" fill="#2F6B55">ab</text>
                    <!-- b^2 -->
                    <rect x="80" y="80" width="36" height="36" rx="6" fill="#F6EBDC" stroke="#DFC5A0" stroke-width="1.5" />
                    <text x="98" y="102" text-anchor="middle" font-size="12" font-weight="600" fill="#9A5B13">b²</text>
                  </svg>
                </div>
                <div class="col-span-7 space-y-2">
                  <p class="text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">
                    Split a square of side <span class="font-mono font-semibold text-[var(--text-primary)]">(a + b)</span>. Four pieces appear naturally—so you never forget the middle <span class="font-mono font-semibold text-[var(--accent-sage)]">2ab</span>.
                  </p>
                  <p class="text-[11px] font-medium text-[var(--accent-sage)]">
                    Visual derivation before symbols
                  </p>
                </div>
              </div>

              <!-- Rote Comparison -->
              <div id="math-preview-rule" class="hidden rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-elevated-soft)] p-4 space-y-1.5">
                <p class="text-xs font-semibold text-[var(--accent-ochre)]">Without visual understanding</p>
                <p class="text-xs sm:text-sm leading-relaxed text-[var(--text-secondary)]">
                  "Just memorize the identity and write a² + b²... wait, was there a 2ab?" Without seeing the square, formulas slip under exam pressure.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-5 lg:col-span-6" data-reveal>
          <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
            <span class="text-[var(--text-primary)]">Core Service</span>
            <span aria-hidden="true">·</span>
            <span>Course Fees</span>
          </div>

          <h3 class="section-h2 !text-3xl sm:!text-4xl">Mathematics</h3>

          <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            Curiosity-first mathematics mentorship building visual intuition and lasting conceptual clarity across school boards, practical finance, and engineering maths.
          </p>

          <ul class="space-y-2 border-t border-[var(--border-subtle)] pt-4 text-sm text-[var(--text-secondary)]">
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--text-primary)] shrink-0"></span>
              <span>Grades 1–12, Money &amp; Math, and B.Tech Engineering</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--text-primary)] shrink-0"></span>
              <span>1-on-1 mentorship &amp; visual derivations</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--text-primary)] shrink-0"></span>
              <span>Aligned with CBSE, ICSE, IGCSE, IB &amp; State boards</span>
            </li>
          </ul>

          <div class="pt-2">
            <a href="/mathematics" class="btn-pill-primary">
              <span>Explore Mathematics</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <ComputerScienceSection />

      <!-- Row 3: Free Career Guidance (Visual Left, Copy Right) -->
      <div class="grid gap-10 pt-14 sm:pt-20 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="lg:col-span-6" data-reveal>
          <div class="rounded-[28px] border border-[var(--border-subtle)] bg-[var(--bg-secondary)] p-6 sm:p-8">
            <div class="rounded-2xl border border-[var(--border-subtle)] bg-white p-5 sm:p-6 shadow-[var(--shadow-subtle)] space-y-4">
              <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
                  Listen-First Guidance Map
                </span>
                <span class="rounded-full bg-[var(--accent-sage-soft)] px-2.5 py-0.5 text-[11px] font-semibold text-[var(--accent-sage)]">
                  Always Free
                </span>
              </div>

              <div class="grid grid-cols-2 gap-2.5 text-xs">
                <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-elevated-soft)] p-3">
                  <p class="font-semibold text-[var(--text-primary)]">Your Goals</p>
                  <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">Interests &amp; strengths</p>
                </div>
                <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-elevated-soft)] p-3">
                  <p class="font-semibold text-[var(--text-primary)]">Real Constraints</p>
                  <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">Eligibility &amp; budget</p>
                </div>
              </div>

              <div class="rounded-xl border border-[var(--accent-sage)]/25 bg-[var(--accent-sage-soft)] p-3.5 text-xs">
                <p class="font-semibold text-[var(--accent-sage)]">Clear Next Paths</p>
                <p class="mt-1 text-[var(--text-secondary)]">
                  Academic streams · Career options · Coaching · Overseas study
                </p>
              </div>

              <p class="text-[11px] leading-relaxed text-[var(--text-muted)]">
                Basic counselling is never charged. Partner referrals are disclosed transparently and based on student fit, never commission.
              </p>
            </div>
          </div>
        </div>

        <div class="space-y-5 lg:col-span-6" data-reveal>
          <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
            <span class="text-[var(--accent-sage)]">Free to Students</span>
            <span aria-hidden="true">·</span>
            <span>Zero Counselling Fee</span>
          </div>

          <h3 class="section-h2 !text-3xl sm:!text-4xl">Career Guidance</h3>

          <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            Free, honest counselling to explore academic choices, career paths, coaching options, and overseas education—always grounded in the student's own goals, eligibility, and budget.
          </p>

          <ul class="space-y-2 border-t border-[var(--border-subtle)] pt-4 text-sm text-[var(--text-secondary)]">
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent-sage)] shrink-0"></span>
              <span>Stream, degree &amp; career direction clarity</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent-sage)] shrink-0"></span>
              <span>Coaching &amp; overseas education exploration</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent-sage)] shrink-0"></span>
              <span>Plain-language partner referral disclosure</span>
            </li>
          </ul>

          <div class="pt-2">
            <a href="/career-guidance" class="btn-pill-sage">
              <span>Explore Free Career Guidance</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Band 3: Real Stories (Brilliant-Style Sliding Carousel + Curved Rotating Wheel Slider, Beige Surface) -->
  <section id="stories" class="surface-beige section-pad scroll-mt-24 overflow-hidden">
    <div class="container-feature space-y-10">
      <div class="mx-auto max-w-2xl text-center space-y-3" data-reveal>
        <h2 class="section-h2">Real Stories of Transformation</h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)]">
          Seeing a child go from "I hate maths" to eagerly explaining a proof at the dinner table is why we exist.
        </p>
      </div>

      <!-- Draggable / Clickable Center-Focus Card Stage -->
      <div
        id="reviews-carousel-stage"
        class="relative mx-auto h-[370px] sm:h-[380px] w-full max-w-[1110px] select-none cursor-grab active:cursor-grabbing touch-pan-y"
        role="region"
        aria-roledescription="carousel"
        aria-label="Parent and student reviews"
        tabindex="0"
      >
        {
          carouselSlides.map((slide, idx) => (
            <article
              data-review-card
              data-slide-idx={idx}
              data-logical-idx={slide.logicalIndex}
              aria-hidden={slide.isClone ? "true" : "false"}
              class="absolute left-1/2 top-1/2 w-[296px] sm:w-[336px] min-h-[325px] rounded-[28px] border border-[var(--border-subtle)] bg-white p-7 sm:p-8 flex flex-col justify-between will-change-transform"
              style="transform: translate3d(-50%, -50%, 0); opacity: 0;"
            >
              <div class="space-y-4">
                <div class="flex items-center gap-1 text-[var(--accent-ochre)]" aria-hidden="true">
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                </div>

                <blockquote class="text-sm sm:text-base leading-relaxed text-[var(--text-primary)]">
                  "{slide.quote}"
                </blockquote>
              </div>

              <footer class="mt-6 pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between">
                <div>
                  <p class="text-sm font-semibold text-[var(--text-primary)]">{slide.name}</p>
                  <p class="text-xs text-[var(--text-muted)]">{slide.role}</p>
                </div>
                <span class="text-[11px] font-medium text-[var(--text-muted)] tabular-nums">
                  {slide.logicalIndex + 1} / {reviews.length}
                </span>
              </footer>
            </article>
          ))
        }
      </div>

      <!-- Curved Rotating Wheel Slider Control -->
      <div class="mx-auto max-w-md flex flex-col items-center gap-2 pt-1">
        <div class="flex items-center gap-3 w-full justify-center">
          <button
            type="button"
            id="reviews-prev-btn"
            aria-label="Previous review"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-white text-[var(--text-primary)] shadow-[var(--shadow-subtle)] transition hover:border-[var(--border-strong)] hover:bg-[var(--bg-elevated-soft)] cursor-pointer"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <div
            id="reviews-wheel-control"
            class="relative flex-1 max-w-[300px] select-none cursor-grab active:cursor-grabbing touch-none"
            role="slider"
            aria-label="Turn wheel to browse reviews"
            aria-valuemin="1"
            aria-valuemax={reviews.length}
            aria-valuenow="2"
            tabindex="0"
          >
            <svg viewBox="0 0 320 64" class="w-full h-16 overflow-hidden" aria-hidden="true">
              <defs>
                <linearGradient id="wheel-fade" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="white" stop-opacity="0" />
                  <stop offset="16%" stop-color="white" stop-opacity="1" />
                  <stop offset="84%" stop-color="white" stop-opacity="1" />
                  <stop offset="100%" stop-color="white" stop-opacity="0" />
                </linearGradient>
                <mask id="wheel-edge-mask">
                  <rect x="0" y="0" width="320" height="64" fill="url(#wheel-fade)" />
                </mask>
              </defs>

              <g mask="url(#wheel-edge-mask)">
                <!-- Subtle Curved Track Horizon (pivot at 160, 380, r = 360) -->
                <circle cx="160" cy="380" r="360" fill="none" stroke="#CFC7BA" stroke-width="1.75" />

                <!-- Rotating 360-deg Wheel Spoke Ticks (seamless continuous spinning) -->
                <g
                  id="reviews-wheel-rotor"
                  style="transform-box: view-box; transform-origin: 160px 380px;"
                >
                  {
                    Array.from({ length: 96 }, (_, idx) => {
                      const deg = idx * 3.75;
                      const isMajor = idx % 4 === 0;
                      const rad = (deg * Math.PI) / 180;
                      const rOuter = 360;
                      const rInner = isMajor ? 344 : 351;
                      const x1 = 160 + rOuter * Math.sin(rad);
                      const y1 = 380 - rOuter * Math.cos(rad);
                      const x2 = 160 + rInner * Math.sin(rad);
                      const y2 = 380 - rInner * Math.cos(rad);
                      return (
                        <line
                          x1={x1.toFixed(2)}
                          y1={y1.toFixed(2)}
                          x2={x2.toFixed(2)}
                          y2={y2.toFixed(2)}
                          stroke={isMajor ? "#2F6B55" : "#B8B0A2"}
                          stroke-width={isMajor ? "2" : "1.25"}
                          stroke-linecap="round"
                        />
                      );
                    })
                  }
                </g>
              </g>

