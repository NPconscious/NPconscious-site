                <span class="text-rose-500 font-bold">&#10003;</span> Regular Parent Syncs
              </div>
            </div>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100">
            <a
              href="https://wa.me/918088276492?text=Hi%2C%20I%20am%20interested%20in%20the%20Regular%20Tuition%20Program."
              class="inline-flex w-full items-center justify-center rounded-full bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-slate-800"
            >
              Inquire / Enroll &rarr;
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- "Why NPconscious" Feature Badges -->
  <section class="px-6 py-20 lg:px-8">
    <div class="mx-auto max-w-6xl space-y-12">
      <div class="text-center space-y-3">
        <span class="inline-block rounded-full bg-amber-50 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-amber-800 border border-amber-200">
          The NPconscious Difference
        </span>
        <h2 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Designed for Clarity, Not Pressure
        </h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-3xl border border-slate-200/80 bg-white p-7 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-800 text-xl font-bold mb-4">
            🔍
          </div>
          <h3 class="text-lg font-bold text-slate-900">Curiosity First</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Students are celebrated for asking questions and exploring multiple ways to solve a problem.</p>
        </div>

        <div class="rounded-3xl border border-slate-200/80 bg-white p-7 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-800 text-xl font-bold mb-4">
            📐
          </div>
          <h3 class="text-lg font-bold text-slate-900">Root Fundamentals</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">We replace memory tricks with foundational logic that withstands any complex exam question.</p>
        </div>

        <div class="rounded-3xl border border-slate-200/80 bg-white p-7 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-100 text-blue-800 text-xl font-bold mb-4">
