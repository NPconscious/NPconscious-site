<script>
  function initHomeOfferingsPreview() {
    const visualBtn = document.getElementById("math-preview-visual-btn");
    const ruleBtn = document.getElementById("math-preview-rule-btn");
    const visualPanel = document.getElementById("math-preview-visual");
    const rulePanel = document.getElementById("math-preview-rule");

    if (!visualBtn || !ruleBtn || !visualPanel || !rulePanel) return;

    const setMode = (mode: "visual" | "rule") => {
      const isVisual = mode === "visual";
      visualBtn.setAttribute("aria-selected", String(isVisual));
      ruleBtn.setAttribute("aria-selected", String(!isVisual));

      visualBtn.classList.toggle("bg-white", isVisual);
      visualBtn.classList.toggle("text-[var(--text-primary)]", isVisual);
      visualBtn.classList.toggle("shadow-[var(--shadow-subtle)]", isVisual);
      visualBtn.classList.toggle("text-[var(--text-muted)]", !isVisual);

      ruleBtn.classList.toggle("bg-white", !isVisual);
      ruleBtn.classList.toggle("text-[var(--text-primary)]", !isVisual);
      ruleBtn.classList.toggle("shadow-[var(--shadow-subtle)]", !isVisual);
      ruleBtn.classList.toggle("text-[var(--text-muted)]", isVisual);

      visualPanel.classList.toggle("hidden", !isVisual);
      rulePanel.classList.toggle("hidden", isVisual);
      (isVisual ? visualPanel : rulePanel).classList.add("tab-panel-enter");
    };

    visualBtn.onclick = () => setMode("visual");
    ruleBtn.onclick = () => setMode("rule");
  }

  function initReviewsCarousel() {
    const stage = document.getElementById("reviews-carousel-stage");
    const wheel = document.getElementById("reviews-wheel-control");
    const rotor = document.getElementById("reviews-wheel-rotor");
    const prevBtn = document.getElementById("reviews-prev-btn");
    const nextBtn = document.getElementById("reviews-next-btn");
    const activeLabel = document.getElementById("reviews-active-label");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-review-card]"));

    if (!stage || !wheel || !rotor || cards.length === 0) return;

    const slideCount = cards.length; // 6 (3 real + 3 wrap clones)
    const reviewLabels = [
      "Sarra · Parent of Grade 8 Student",
      "Maaz · Grade 10 Learner",
      "Rohit · Parent of Grade 9 Student",
    ];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const easeTransition = reducedMotion
      ? "none"
      : "transform 0.75s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1), filter 0.75s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.75s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.75s cubic-bezier(0.22, 1, 0.36, 1)";
    const wheelTransition = reducedMotion
      ? "none"
      : "transform 0.75s cubic-bezier(0.22, 1, 0.36, 1)";

    let virtualPos = 1; // Continuous unbounded position; 1 = Maaz centered, +/- infinite
    let dragStartPos = 1;
    let isDragging = false;
    let dragMode: "stage" | "wheel" | null = null;
    let startX = 0;
    let lastX = 0;
    let lastTime = 0;
    let velocityPxPerMs = 0;
    let movedDuringDrag = false;

    const getStride = () => (window.innerWidth < 640 ? 286 : 344);

    function wrappedOffset(cardIdx: number, centerPos: number): number {
      let offset = (((cardIdx - centerPos) % slideCount) + slideCount) % slideCount;
      if (offset >= slideCount / 2) offset -= slideCount;
      return offset;
    }

    function renderCarousel(instant = false) {
      const stride = getStride();
      const transitionStyle = instant || isDragging ? "none" : easeTransition;

      cards.forEach((card, i) => {
        const offset = wrappedOffset(i, virtualPos);
        const absOffset = Math.abs(offset);

        const translateX = offset * stride;
        const scale = Math.max(0.84, 1 - absOffset * 0.1);
        const opacity = absOffset > 2.1 ? 0 : Math.max(0.25, 1 - absOffset * 0.38);
        const blur = absOffset > 0.35 ? Math.min(1.2, absOffset * 0.55) : 0;
        const zIndex = 30 - Math.round(absOffset * 10);
        const isCenter = absOffset < 0.35;

        card.style.transition = transitionStyle;
        card.style.transform = `translate3d(calc(-50% + ${translateX.toFixed(1)}px), -50%, 0) scale(${scale.toFixed(3)})`;
        card.style.opacity = opacity.toFixed(3);
        card.style.filter = blur > 0.05 && !reducedMotion ? `blur(${blur.toFixed(2)}px)` : "none";
        card.style.zIndex = String(zIndex);
        card.style.boxShadow = isCenter
          ? "0 12px 40px 0 rgba(20, 20, 20, 0.08)"
          : "0 1px 3px rgba(20, 20, 20, 0.04)";
        card.style.borderColor = isCenter ? "var(--border-strong)" : "var(--border-subtle)";
        card.style.pointerEvents = absOffset > 1.8 ? "none" : "auto";
        card.style.cursor = isCenter ? "grab" : "pointer";
      });

      const liveAngle = -virtualPos * 15; // 15deg per review lands cleanly on major sage ticks
      rotor.style.transition = instant || isDragging ? "none" : wheelTransition;
      rotor.style.transform = `rotate(${liveAngle.toFixed(2)}deg)`;

      const snapped = Math.round(virtualPos);
      const logical = ((snapped % 3) + 3) % 3;
      wheel.setAttribute("aria-valuenow", String(logical + 1));
      if (activeLabel) {
        activeLabel.textContent = reviewLabels[logical];
      }
    }

    function stepBy(deltaSlides: number) {
      virtualPos = Math.round(virtualPos) + deltaSlides;
      renderCarousel(false);
    }

    // Side-card click advances smoothly to that card
    cards.forEach((card, i) => {
      card.onclick = () => {
        if (movedDuringDrag) return;
        const delta = wrappedOffset(i, Math.round(virtualPos));
        if (delta !== 0) stepBy(delta);
      };
    });

    prevBtn?.addEventListener("click", () => stepBy(-1));
    nextBtn?.addEventListener("click", () => stepBy(1));

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        stepBy(-1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        stepBy(1);
      }
    };
    stage.addEventListener("keydown", onKeyDown);
    wheel.addEventListener("keydown", onKeyDown);

    const startDrag = (mode: "stage" | "wheel", clientX: number, target: HTMLElement, pointerId: number) => {
      isDragging = true;
      dragMode = mode;
      dragStartPos = virtualPos;
      startX = clientX;
      lastX = clientX;
      lastTime = performance.now();
      velocityPxPerMs = 0;
      movedDuringDrag = false;
      try {
        target.setPointerCapture(pointerId);
      } catch {}
    };

    stage.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      startDrag("stage", e.clientX, stage, e.pointerId);
    });

    wheel.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      startDrag("wheel", e.clientX, wheel, e.pointerId);
    });

    const onPointerMove = (e: PointerEvent) => {
      if (!isDragging || !dragMode) return;
      const now = performance.now();
      const dt = Math.max(1, now - lastTime);
      velocityPxPerMs = (e.clientX - lastX) / dt;
      lastX = e.clientX;
      lastTime = now;

      const dx = e.clientX - startX;
      if (Math.abs(dx) > 6) movedDuringDrag = true;

      // Calm, lower sensitivity so continuous multi-card scrolling feels controlled
      const sensitivity = dragMode === "wheel" ? 160 : getStride() * 1.4;
      virtualPos = dragStartPos - dx / sensitivity;
      renderCarousel(true);
    };

    const onPointerEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      const mode = dragMode;
      dragMode = null;

      const movedCards = virtualPos - dragStartPos;
      let targetPos = Math.round(virtualPos);

      // If user made a quick short flick (< 0.45 card), advance 1 card in flick direction
      if (Math.abs(movedCards) < 0.45 && Math.abs(velocityPxPerMs) > (mode === "wheel" ? 0.25 : 0.35)) {
        targetPos = Math.round(dragStartPos) + (velocityPxPerMs < 0 ? 1 : -1);
      }

      virtualPos = targetPos;
      renderCarousel(false);
      setTimeout(() => {
        movedDuringDrag = false;
      }, 60);
    };

    stage.addEventListener("pointermove", onPointerMove);
    wheel.addEventListener("pointermove", onPointerMove);
    stage.addEventListener("pointerup", onPointerEnd);
    stage.addEventListener("pointercancel", onPointerEnd);
    wheel.addEventListener("pointerup", onPointerEnd);
    wheel.addEventListener("pointercancel", onPointerEnd);

    window.addEventListener("resize", () => renderCarousel(true));
    renderCarousel(true);
  }

  document.addEventListener("astro:page-load", () => {
