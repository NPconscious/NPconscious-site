---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Admission & First Step"
  description="Start your journey with NPconscious: book a Mathematics diagnostic assessment, express interest in Computer Science, schedule free Career Guidance, or start a listen-first conversation."
>
  <!-- Hero Section (Warm Beige) -->
  <section class="surface-beige px-5 pt-12 pb-16 sm:pt-16 sm:pb-20 lg:px-8 lg:pt-20 lg:pb-24">
    <div class="container-feature">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
        <div class="space-y-6 lg:col-span-7">
          <h1 class="display-h1" data-hero-reveal>
            Start Your Learning<br />
            or Guidance Journey
          </h1>

          <p class="max-w-2xl text-base sm:text-lg leading-relaxed text-[var(--text-secondary)]" data-hero-reveal>
            Every student starts from a different place. Whether you want a 30-minute Mathematics assessment, want to share interest in <strong>Computer Science</strong>, need <strong>free Career Guidance</strong>, or are unsure where to begin, our first conversation has zero pressure.
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-1" data-hero-reveal>
            <a href="#book-assessment" class="btn-pill-primary">
              <span>Book Free First Step</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a href="#assessment-tracks" class="btn-pill-secondary">
              <span>View Maths Assessment Tracks</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5" data-hero-reveal>
          <div class="overflow-hidden rounded-[24px] border border-[var(--border-subtle)] bg-white">
            <img
              src="/mountain-reflection.jpg"
              alt="Mountain lake reflection representing NPconscious Sanctuary for Young Minds"
              class="w-full h-auto object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3-Step Roadmap (White Surface) -->
  <section class="surface-white section-pad border-y border-[var(--border-subtle)]">
    <div class="container-feature space-y-12">
      <div class="max-w-2xl space-y-3">
        <h2 class="section-h2">Three Easy Steps to Get Started</h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)]">
          A straightforward intake process for students and parents.
        </p>
      </div>

      <ol class="grid gap-8 md:grid-cols-3">
        <li class="border-t border-[var(--border-strong)] pt-6 space-y-2.5">
          <div class="flex items-baseline justify-between gap-2">
            <span class="text-sm font-semibold text-[var(--text-muted)] tabular-nums">01</span>
            <span class="text-xs font-medium text-[var(--accent-ochre)]">Under 1 minute</span>
          </div>
          <h3 class="text-lg font-semibold text-[var(--text-primary)]">Share Student Details</h3>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            Tell us what you are exploring—Mathematics, Computer Science, free Career Guidance, or "Not sure yet"—along with grade and how you found us.
          </p>
        </li>

        <li class="border-t border-[var(--border-strong)] pt-6 space-y-2.5">
          <div class="flex items-baseline justify-between gap-2">
            <span class="text-sm font-semibold text-[var(--accent-sage)] tabular-nums">02</span>
            <span class="text-xs font-medium text-[var(--accent-sage)]">Parents welcomed</span>
          </div>
          <h3 class="text-lg font-semibold text-[var(--text-primary)]">Listen-First Session</h3>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            A 1-on-1 conversation or 30-minute visual Mathematics discovery session focused on understanding how the learner thinks.
          </p>
        </li>

        <li class="border-t border-[var(--border-strong)] pt-6 space-y-2.5">
          <div class="flex items-baseline justify-between gap-2">
            <span class="text-sm font-semibold text-[var(--text-muted)] tabular-nums">03</span>
            <span class="text-xs font-medium text-[var(--text-muted)]">No compulsory upsells</span>
          </div>
          <h3 class="text-lg font-semibold text-[var(--text-primary)]">Agree on Next Steps</h3>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            Receive qualitative feedback, a recommended Mathematics track, free career options, or updates when Computer Science cohorts open.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Interactive Mathematics Diagnostic Assessment Tracks (Beige Surface) -->
  <section id="assessment-tracks" class="surface-beige section-pad">
    <div class="container-reading space-y-10">
      <div class="space-y-3">
        <h2 class="section-h2">Mathematics Assessment Tracks</h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)]">
          For Mathematics learners, each session evaluates foundational reasoning, visual logic, and conceptual derivation.
        </p>
      </div>

      <!-- Segmented Pill Switcher -->
      <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Mathematics diagnostic tracks">
        <button type="button" role="tab" id="tab-track-primary" data-track="primary" aria-selected="true" class="track-tab pill-tab is-active">
          Classes 1–5
        </button>
        <button type="button" role="tab" id="tab-track-middle" data-track="middle" aria-selected="false" class="track-tab pill-tab">
          Classes 6–10
        </button>
        <button type="button" role="tab" id="tab-track-senior" data-track="senior" aria-selected="false" class="track-tab pill-tab">
          Classes 11–12
        </button>
        <button type="button" role="tab" id="tab-track-money" data-track="money" aria-selected="false" class="track-tab pill-tab">
          Money &amp; Math
        </button>
        <button type="button" role="tab" id="tab-track-eng" data-track="eng" aria-selected="false" class="track-tab pill-tab">
          Engineering
        </button>
      </div>

      <div class="sanctuary-card p-6 sm:p-10">
        <!-- 1. Primary -->
        <div id="panel-track-primary" class="track-panel space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-[var(--border-subtle)]">
            <h3 class="text-xl sm:text-2xl font-semibold text-[var(--text-primary)]">Primary Assessment (Classes 1–5)</h3>
            <span class="inline-flex items-center self-start rounded-full bg-[var(--accent-sage-soft)] px-3.5 py-1.5 text-xs font-semibold text-[var(--accent-sage)]">
              30 mins · 1-on-1
            </span>
          </div>
          <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            Playful visual riddles, pattern completion, and intuitive counting without test anxiety.
          </p>
          <dl class="grid gap-5 border-t border-[var(--border-subtle)] pt-5 sm:grid-cols-3">
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Session Format</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">30 minutes, 1-on-1 discovery</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Parents Welcomed</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">Sit in and observe alongside your child</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Focus Area</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">Spatial logic and number patterns</dd>
            </div>
          </dl>
          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-t border-[var(--border-subtle)]">
            <a
              href="https://wa.me/918011236456?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Classes%201-5."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-pill-primary !text-xs sm:!text-sm"
            >
              <span>Book Class 1–5 Assessment</span>
            </a>
            <a href="#book-assessment" class="text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-primary)] text-center sm:text-left">
              Or schedule via form below ↓
            </a>
          </div>
        </div>

        <!-- 2. Middle & High -->
        <div id="panel-track-middle" class="track-panel hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-[var(--border-subtle)]">
            <h3 class="text-xl sm:text-2xl font-semibold text-[var(--text-primary)]">Middle &amp; High School (Classes 6–10)</h3>
            <span class="inline-flex items-center self-start rounded-full bg-[var(--accent-sage-soft)] px-3.5 py-1.5 text-xs font-semibold text-[var(--accent-sage)]">
              30 mins · 1-on-1
            </span>
          </div>
          <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            Algebraic logic, geometry derivation, word puzzles, and fundamental number intuition.
          </p>
          <dl class="grid gap-5 border-t border-[var(--border-subtle)] pt-5 sm:grid-cols-3">
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Session Format</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">30 minutes, personal attention</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Concept Depth</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">Checks why formulas work, not recall speed</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Board Alignment</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">CBSE, ICSE, IGCSE, IB &amp; State</dd>
            </div>
          </dl>
          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-t border-[var(--border-subtle)]">
            <a
              href="https://wa.me/918011236456?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Classes%206-10."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-pill-primary !text-xs sm:!text-sm"
            >
              <span>Book Class 6–10 Assessment</span>
            </a>
            <a href="#book-assessment" class="text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-primary)] text-center sm:text-left">
              Or schedule via form below ↓
            </a>
          </div>
        </div>

        <!-- 3. Senior Secondary -->
        <div id="panel-track-senior" class="track-panel hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-[var(--border-subtle)]">
            <h3 class="text-xl sm:text-2xl font-semibold text-[var(--text-primary)]">Senior Secondary (Classes 11–12)</h3>
            <span class="inline-flex items-center self-start rounded-full bg-[var(--accent-sage-soft)] px-3.5 py-1.5 text-xs font-semibold text-[var(--accent-sage)]">
              30 mins · 1-on-1
            </span>
          </div>
          <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            Evaluating intuition in calculus, trigonometry, coordinate geometry, and problem attack strategy.
          </p>
          <dl class="grid gap-5 border-t border-[var(--border-subtle)] pt-5 sm:grid-cols-3">
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Session Format</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">30 minutes, 1-on-1 diagnostic</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Entrance Readiness</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">Conceptual gaps across senior STEM topics</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Calculus Review</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">Limits, rates of change, and geometric proofs</dd>
            </div>
          </dl>
          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-t border-[var(--border-subtle)]">
            <a
              href="https://wa.me/918011236456?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Classes%2011-12."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-pill-primary !text-xs sm:!text-sm"
            >
              <span>Book Class 11–12 Assessment</span>
            </a>
            <a href="#book-assessment" class="text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-primary)] text-center sm:text-left">
              Or schedule via form below ↓
            </a>
          </div>
        </div>

        <!-- 4. Money & Math -->
        <div id="panel-track-money" class="track-panel hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-[var(--border-subtle)]">
            <h3 class="text-xl sm:text-2xl font-semibold text-[var(--text-primary)]">Money &amp; Mathematics</h3>
            <span class="inline-flex items-center self-start rounded-full bg-[var(--accent-sage-soft)] px-3.5 py-1.5 text-xs font-semibold text-[var(--accent-sage)]">
              30 mins · Ages 12+ &amp; Adults
            </span>
          </div>
          <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            Scenario-based session exploring compound interest logic, risk probability, and everyday financial reasoning.
          </p>
          <dl class="grid gap-5 border-t border-[var(--border-subtle)] pt-5 sm:grid-cols-3">
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Real-Life Scenarios</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">30 minutes of practical case discussion</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Probability Logic</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">Risk vs reward number sense</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Financial Decisions</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">Inflation, compounding, and trade-offs</dd>
            </div>
          </dl>
          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-t border-[var(--border-subtle)]">
            <a
              href="https://wa.me/918011236456?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Money%20%26%20Mathematics."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-pill-primary !text-xs sm:!text-sm"
            >
              <span>Book Money &amp; Math Assessment</span>
            </a>
            <a href="#book-assessment" class="text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-primary)] text-center sm:text-left">
              Or schedule via form below ↓
            </a>
          </div>
        </div>

        <!-- 5. Engineering -->
        <div id="panel-track-eng" class="track-panel hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-[var(--border-subtle)]">
            <h3 class="text-xl sm:text-2xl font-semibold text-[var(--text-primary)]">Engineering Mathematics</h3>
            <span class="inline-flex items-center self-start rounded-full bg-[var(--bg-sand-soft)] px-3.5 py-1.5 text-xs font-semibold text-[var(--text-primary)]">
              1 Hour · Undergraduate / B.Tech
            </span>
          </div>
          <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            Evaluating problem solving for university engineering coursework and computational maths.
          </p>
          <dl class="grid gap-5 border-t border-[var(--border-subtle)] pt-5 sm:grid-cols-2">
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Written Problem Review</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">Dedicated 1-hour walkthrough of university problem sets</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold text-[var(--text-primary)]">Core Syllabus Topics</dt>
              <dd class="mt-1 text-xs text-[var(--text-muted)]">Linear algebra, differential equations, Laplace &amp; Fourier</dd>
            </div>
          </dl>
          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-t border-[var(--border-subtle)]">
            <a
              href="https://wa.me/918011236456?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Engineering%20Mathematics."
              target="_blank"
              rel="noopener noreferrer"
              class="btn-pill-primary !text-xs sm:!text-sm"
            >
              <span>Book Engineering Slot</span>
            </a>
            <a href="#book-assessment" class="text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-primary)] text-center sm:text-left">
              Or schedule via form below ↓
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Inline Sanctuary Intake & Assessment Booking Form (White Surface) -->
  <section id="book-assessment" class="surface-white section-pad border-y border-[var(--border-subtle)]">
    <div class="container-reading">
      <div class="sanctuary-card-beige p-6 sm:p-10">
        <div class="space-y-2 mb-8">
          <h2 class="section-h2 !text-2xl sm:!text-3xl">Book Your Free First Step</h2>
          <p class="text-sm text-[var(--text-secondary)]">
            Choose what you are exploring below to open a pre-filled WhatsApp message with our team.
          </p>
        </div>

        <form id="assessment-form" class="space-y-5">
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="interest-area" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">
                What are you looking for?
              </label>
              <select
                id="interest-area"
                name="interest-area"
                class="w-full rounded-xl border border-[var(--border-strong)] bg-white px-4 py-3 text-sm text-[var(--text-primary)]"
              >
                <option value="Mathematics Assessment">Mathematics Assessment</option>
                <option value="Free Career Guidance">Free Career Guidance (Always Free)</option>
                <option value="Computer Science Interest">Computer Science Interest</option>
                <option value="Not sure yet — help me choose">Not sure yet — help me choose</option>
              </select>
            </div>

            <div>
              <label for="lead-source" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">
                How did you hear about us?
              </label>
              <select
                id="lead-source"
                name="lead-source"
                class="w-full rounded-xl border border-[var(--border-strong)] bg-white px-4 py-3 text-sm text-[var(--text-primary)]"
              >
                <option value="">Select source (optional)</option>
                <option value="Google Search">Google Search</option>
                <option value="Instagram / Social Media">Instagram / Social Media</option>
                <option value="Friend / Parent Referral">Friend / Parent Referral</option>
                <option value="School / Teacher">School / Teacher</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="student-name" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">
                Student name
              </label>
              <input
                type="text"
                id="student-name"
                name="student-name"
                placeholder="e.g. Aarav Sharma"
                class="w-full rounded-xl border border-[var(--border-strong)] bg-white px-4 py-3 text-sm text-[var(--text-primary)]"
              />
            </div>

            <div>
              <label for="student-grade" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">
                Current grade / level
              </label>
              <select
                id="student-grade"
                name="student-grade"
                class="w-full rounded-xl border border-[var(--border-strong)] bg-white px-4 py-3 text-sm text-[var(--text-primary)]"
              >
                <option value="">Select Grade / Track</option>
                <option value="Money & Mathematics">Money &amp; Mathematics</option>
                <option value="Grade 1-5 (Primary)">Grade 1–5 (Primary Foundations)</option>
                <option value="Grade 6-8 (Middle School)">Grade 6–8 (Middle School)</option>
                <option value="Grade 9-10 (Board Prep)">Grade 9–10 (Board Exam Prep)</option>
                <option value="Grade 11-12 (Senior Secondary)">Grade 11–12 (Calculus &amp; STEM)</option>
                <option value="Engineering Mathematics">Engineering Mathematics (B.Tech)</option>
                <option value="College / Graduate / Exploring Options">College / Graduate / Exploring Options</option>
              </select>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="parent-phone" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">
                Student or parent WhatsApp number
              </label>
              <input
                type="tel"
                id="parent-phone"
                name="parent-phone"
                placeholder="+91 98765 43210"
                class="w-full rounded-xl border border-[var(--border-strong)] bg-white px-4 py-3 text-sm text-[var(--text-primary)]"
              />
            </div>

            <div>
              <label for="preferred-time" class="block text-xs font-semibold text-[var(--text-secondary)] mb-1.5">
                Preferred time slot
              </label>
              <select
                id="preferred-time"
                name="preferred-time"
                class="w-full rounded-xl border border-[var(--border-strong)] bg-white px-4 py-3 text-sm text-[var(--text-primary)]"
              >
                <option value="Flexible / Anytime">Flexible / Any time</option>
                <option value="Weekday Evening (5 PM - 8 PM)">Weekday Evening (5 PM – 8 PM)</option>
                <option value="Weekend Morning (10 AM - 1 PM)">Weekend Morning (10 AM – 1 PM)</option>
                <option value="Weekend Afternoon (2 PM - 6 PM)">Weekend Afternoon (2 PM – 6 PM)</option>
              </select>
            </div>
          </div>

          <button type="submit" id="btn-whatsapp-submit" class="btn-pill-primary w-full">
            <span>Continue to WhatsApp Booking</span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <p class="text-center text-xs text-[var(--text-muted)]">
            Prefer direct chat? <a href="https://wa.me/918011236456?text=Hi%2C%20I%20would%20like%20to%20start%20a%20conversation%20with%20NPconscious." target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--text-primary)] underline">Chat on WhatsApp</a> · Sending reports or questions? Email
            <!--email_off-->
            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=admission@npconscious.com" target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--text-primary)] underline">admission@npconscious.com</a>
            <!--/email_off-->
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- Session Notes & Direct Assistance (Beige Surface) -->
  <section class="surface-beige section-pad">
    <div class="container-reading">
      <div class="grid gap-10 md:grid-cols-2">
        <div class="space-y-3">
          <h2 class="text-xl font-semibold text-[var(--text-primary)]">Preparing for Session Day</h2>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            Join five minutes early from a quiet spot with a notebook and pen. No formulas or advance preparation are required, and parents are welcome to sit in.
          </p>
        </div>

        <div class="space-y-3 border-t border-[var(--border-subtle)] pt-6 md:border-t-0 md:border-l md:pt-0 md:pl-10">
          <h2 class="text-xl font-semibold text-[var(--text-primary)]">Direct Admissions Desk</h2>
          <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
            For custom scheduling or school-report attachments, write to us or call directly:
          </p>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-semibold text-[var(--text-primary)]">
            <!--email_off-->
            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=admission@npconscious.com" target="_blank" rel="noopener noreferrer" class="underline">admission@npconscious.com</a>
            <!--/email_off-->
            <span class="text-[var(--text-muted)]" aria-hidden="true">·</span>
            <a href="tel:+918011236456" class="hover:underline">+91 80112 36456</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  function initAdmissionPage() {
    const form = document.getElementById("assessment-form") as HTMLFormElement | null;
    const interestSelect = document.getElementById("interest-area") as HTMLSelectElement | null;
    const sourceSelect = document.getElementById("lead-source") as HTMLSelectElement | null;
    const studentName = document.getElementById("student-name") as HTMLInputElement | null;
    const studentGrade = document.getElementById("student-grade") as HTMLSelectElement | null;
    const parentPhone = document.getElementById("parent-phone") as HTMLInputElement | null;
    const preferredTime = document.getElementById("preferred-time") as HTMLSelectElement | null;

    // Pre-select interest area from URL query string (e.g. ?interest=career-guidance)
    const params = new URLSearchParams(window.location.search);
    const interestParam = params.get("interest");
    if (interestSelect && interestParam) {
      const interestMap: Record<string, string> = {
        mathematics: "Mathematics Assessment",
        "career-guidance": "Free Career Guidance",
        "computer-science": "Computer Science Interest",
        "not-sure": "Not sure yet — help me choose",
      };
      if (interestMap[interestParam]) {
        interestSelect.value = interestMap[interestParam];
      }
    }

    if (form) {
      form.onsubmit = (e: Event) => {
        e.preventDefault();
        const interestVal = interestSelect?.value?.trim() || "First Conversation";
        const sourceVal = sourceSelect?.value?.trim() || "";
        const nameVal = studentName?.value?.trim() || "";
        const gradeVal = studentGrade?.value?.trim() || "";
        const phoneVal = parentPhone?.value?.trim() || "";
        const timeVal = preferredTime?.value?.trim() || "Flexible / Anytime";

        let message = `Hi NPconscious team,\n\nI would like to connect regarding: ${interestVal}.`;
        if (nameVal) message += `\n\n*Student Name:* ${nameVal}`;
        if (gradeVal) message += `\n*Grade / Level:* ${gradeVal}`;
        if (phoneVal) message += `\n*WhatsApp:* ${phoneVal}`;
        if (timeVal && timeVal !== "Flexible / Anytime") message += `\n*Preferred Slot:* ${timeVal}`;
        if (sourceVal) message += `\n*Heard About NPconscious Via:* ${sourceVal}`;

        const waUrl = "https://wa.me/918011236456?text=" + encodeURIComponent(message);
        const win = window.open(waUrl, "_blank", "noopener,noreferrer");
        if (!win) window.location.href = waUrl;
      };
    }

    const trackTabs = document.querySelectorAll<HTMLButtonElement>(".track-tab");
    const trackPanels = document.querySelectorAll<HTMLElement>(".track-panel");

    const gradeMapping: Record<string, string> = {
      primary: "Grade 1-5 (Primary)",
      middle: "Grade 6-8 (Middle School)",
      senior: "Grade 11-12 (Senior Secondary)",
      money: "Money & Mathematics",
      eng: "Engineering Mathematics",
    };

    trackTabs.forEach((tab) => {
      tab.onclick = () => {
        const trackKey = tab.dataset.track || "primary";

        trackTabs.forEach((t) => {
          t.classList.remove("is-active");
          t.setAttribute("aria-selected", "false");
        });
        tab.classList.add("is-active");
        tab.setAttribute("aria-selected", "true");

        trackPanels.forEach((panel) => {
          panel.classList.add("hidden");
          panel.classList.remove("tab-panel-enter");
        });

        const activePanel = document.getElementById(`panel-track-${trackKey}`);
        if (activePanel) {
          activePanel.classList.remove("hidden");
          activePanel.classList.add("tab-panel-enter");
        }

        if (studentGrade && gradeMapping[trackKey]) {
          studentGrade.value = gradeMapping[trackKey];
        }
      };
    });
  }

  document.addEventListener("astro:page-load", initAdmissionPage);
</script>
