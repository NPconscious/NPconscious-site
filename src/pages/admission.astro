---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Admission">
  <!-- Hero Section: Warm, Reassuring, Clear for Parents -->
  <section class="relative overflow-hidden bg-hero-texture px-4 pt-8 pb-14 sm:px-6 sm:pt-14 sm:pb-20 lg:px-8 lg:pt-16 lg:pb-24">
    <div class="mx-auto max-w-[1360px]">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <!-- Left Hero Content -->
        <div class="space-y-6 lg:col-span-7">
          <!-- Text block with blended mountain reflection backdrop -->
          <div id="admission-hero-container" class="relative">
            <!-- Blended Mountain Image Backdrop -->
            <div 
              id="admission-mountain-backdrop"
              class="pointer-events-none absolute select-none z-0 right-0 sm:right-4 lg:right-6 -top-2 sm:-top-4 bottom-0 w-[260px] sm:w-[350px] lg:w-[410px] aspect-square max-w-[430px] overflow-hidden"
              aria-hidden="true"
            >
              <!-- Outer fade on left to smoothly start from 'l' -->
              <div 
                class="w-full h-full relative"
                style="
                  -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 8%, black 20%, black 100%);
                  mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 8%, black 20%, black 100%);
                "
              >
                <!-- Inner elliptical mask to feather edges into canvas -->
                <div 
                  class="w-full h-full relative"
                  style="
                    -webkit-mask-image: radial-gradient(ellipse 75% 70% at 55% 50%, rgba(0,0,0,1) 25%, rgba(0,0,0,0.65) 55%, transparent 95%);
                    mask-image: radial-gradient(ellipse 75% 70% at 55% 50%, rgba(0,0,0,1) 25%, rgba(0,0,0,0.65) 55%, transparent 95%);
                  "
                >
                  <!-- Mountain Reflection Photo -->
                  <img 
                    src="/mountain-reflection.jpg" 
                    alt="" 
                    class="w-full h-full object-cover object-[50%_45%] opacity-80 contrast-[1.06] saturate-[1.12]"
                    loading="eager"
                    decoding="async"
                  />
                  <!-- Soft Warm Ambient Scrims to harmonize with #FAF8F5 background -->
                  <div class="absolute inset-0 bg-gradient-to-r from-[#FAF8F5]/85 via-[#FAF8F5]/25 to-transparent pointer-events-none"></div>
                  <div class="absolute inset-0 bg-gradient-to-b from-[#FAF8F5]/35 via-transparent to-[#FAF8F5]/45 pointer-events-none"></div>
                </div>
              </div>
            </div>

            <!-- Foreground Content: crisp typography elevated on top of image -->
            <div class="relative z-10 space-y-6">
              <div class="inline-flex items-center gap-2 rounded-full border border-amber-300/80 bg-amber-50/90 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-amber-900 shadow-xs backdrop-blur-sm">
                <span class="flex h-2 w-2 rounded-full bg-amber-500"></span>
                <span>Simple 3-Step Assessment</span>
              </div>

              <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl leading-[1.12] text-layer-elevated" style="text-shadow: 0 1px 3px rgba(250, 248, 245, 0.95), 0 0 20px rgba(250, 248, 245, 0.9);">
                Start Your Child's<br />
                <span class="text-amber-600">Learning Journey</span>
              </h1>

              <p class="max-w-2xl text-base sm:text-lg leading-relaxed text-slate-700 font-medium text-layer-elevated" style="text-shadow: 0 1px 3px rgba(250, 248, 245, 0.95), 0 0 20px rgba(250, 248, 245, 0.9);">
                Every learner thinks differently. Our 30-minute assessment is completely stress-free — we focus on understanding your child's innate logic, curiosity, and learning style rather than judging marks.
              </p>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-1">
            <a
              href="#book-assessment"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-amber-600 hover:bg-amber-700 px-7 py-3.5 text-sm font-semibold text-white shadow-soft transition-all hover:shadow-hover hover:-translate-y-0.5 active:translate-y-0"
            >
              <span>Schedule Assessment</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </a>
            <a
              href="#assessment-tracks"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-800 shadow-xs transition hover:bg-slate-50 hover:border-slate-400"
            >
              <span>View Assessment Tracks</span>
            </a>
          </div>

          <!-- Academic Trust Chips -->
          <div class="flex flex-wrap items-center gap-2.5 pt-2 text-xs font-semibold text-slate-700">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 border border-slate-200/90 shadow-xs">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              Zero Pressure or Scoring Stigma
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 border border-slate-200/90 shadow-xs">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              Detailed Qualitative Parent Feedback
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 border border-slate-200/90 shadow-xs">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              Personalized Learning Roadmap
            </span>
          </div>
        </div>

        <!-- Right Visual: Assessment Overview Showcase Card -->
        <div class="relative lg:col-span-5">
          <div class="relative rounded-3xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-soft stretchy-scroll">
            <div class="overflow-hidden rounded-2xl bg-slate-50 border border-slate-100">
              <img
                src="/graph.webp"
                alt="3 out of 5 students fear maths - Overcoming mathsphobia with NPconscious"
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            <div class="mt-4 flex items-center justify-between text-xs font-medium text-slate-600 border-t border-slate-100 pt-3">
              <span class="inline-flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                Live 1-on-1 Guidance
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                Parents Welcomed to Join
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3-Step Admission Roadmap (Friendly Timeline) -->
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8 bg-white border-b border-slate-200/80">
    <div class="mx-auto max-w-5xl space-y-12">
      <div class="text-center space-y-3">
        <span class="inline-block rounded-full bg-slate-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-slate-700">
          How It Works
        </span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Three Easy Steps to Get Started
        </h2>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600">
          We keep the process transparent, supportive, and hassle-free for parents.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- Step 1 -->
        <div class="relative rounded-3xl border border-slate-200/90 bg-[#FAF8F5] p-7 shadow-soft transition hover-spring reveal-on-scroll stagger-1 stretchy-scroll">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-800 font-bold mb-5 tabular-nums">
            01
          </div>
          <h3 class="text-lg font-bold text-slate-900">Share Student Details</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Share your child’s current grade, school board (CBSE, ICSE, IGCSE, State), and any specific math topics they find challenging.
          </p>
          <div class="mt-5 text-xs font-semibold text-amber-700 flex items-center gap-1">
            <span>Takes under 1 minute</span>
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="relative rounded-3xl border border-slate-200/90 bg-[#FAF8F5] p-7 shadow-soft transition hover-spring reveal-on-scroll stagger-2 stretchy-scroll">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-100 text-indigo-800 font-bold mb-5 tabular-nums">
            02
          </div>
          <h3 class="text-lg font-bold text-slate-900">30-Min Assessment Session</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            A friendly online 1-on-1 session where we explore visual puzzles together. Zero marks pressure — just joyful problem solving.
          </p>
          <div class="mt-5 text-xs font-semibold text-indigo-700 flex items-center gap-1">
            <span>Parents are welcomed to attend</span>
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="relative rounded-3xl border border-slate-200/90 bg-[#FAF8F5] p-7 shadow-soft transition hover-spring reveal-on-scroll stagger-3 stretchy-scroll">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-800 font-bold mb-5 tabular-nums">
            03
          </div>
          <h3 class="text-lg font-bold text-slate-900">Personalized Growth Roadmap</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            We share comprehensive feedback highlighting your child’s cognitive strengths and recommend the exact curriculum path for them.
          </p>
          <div class="mt-5 text-xs font-semibold text-emerald-700 flex items-center gap-1">
            <span>Tailored learning blueprint</span>
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Diagnostic Assessment Tracks Selector -->
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8 bg-white border-b border-slate-200/80" id="assessment-tracks">
    <div class="mx-auto max-w-4xl space-y-10">
      <div class="text-center space-y-3">
        <span class="inline-block rounded-full bg-amber-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-amber-900 border border-amber-200">
          Tailored Diagnostic Tracks
        </span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Choose Your Child's Assessment Track
        </h2>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600">
          Every session is customized to evaluate foundational thinking, visual spatial logic, and conceptual derivation at your child's stage.
        </p>
      </div>

      <!-- Segmented Tab Switcher -->
      <div class="flex rounded-2xl bg-slate-100/90 p-1.5 text-xs font-semibold overflow-x-auto scrollbar-none gap-1 sm:gap-1.5" role="tablist">
        <button
          type="button"
          role="tab"
          id="tab-track-primary"
          data-track="primary"
          aria-selected="true"
          class="track-tab flex-1 min-w-[110px] rounded-xl py-2.5 px-3 text-center transition cursor-pointer bg-white text-slate-900 shadow-xs font-bold"
        >
          Classes 1–5
        </button>
        <button
          type="button"
          role="tab"
          id="tab-track-middle"
          data-track="middle"
          aria-selected="false"
          class="track-tab flex-1 min-w-[110px] rounded-xl py-2.5 px-3 text-center transition cursor-pointer text-slate-600 hover:text-slate-900"
        >
          Classes 6–10
        </button>
        <button
          type="button"
          role="tab"
          id="tab-track-senior"
          data-track="senior"
          aria-selected="false"
          class="track-tab flex-1 min-w-[110px] rounded-xl py-2.5 px-3 text-center transition cursor-pointer text-slate-600 hover:text-slate-900"
        >
          Classes 11–12
        </button>
        <button
          type="button"
          role="tab"
          id="tab-track-money"
          data-track="money"
          aria-selected="false"
          class="track-tab flex-1 min-w-[130px] rounded-xl py-2.5 px-3 text-center transition cursor-pointer text-slate-600 hover:text-slate-900"
        >
          Money &amp; Math
        </button>
        <button
          type="button"
          role="tab"
          id="tab-track-eng"
          data-track="eng"
          aria-selected="false"
          class="track-tab flex-1 min-w-[120px] rounded-xl py-2.5 px-3 text-center transition cursor-pointer text-slate-600 hover:text-slate-900"
        >
          Engineering
        </button>
      </div>

      <!-- Track Detail Display Cards -->
      <div class="rounded-3xl border border-slate-200/90 bg-[#FAF8F5] p-6 sm:p-10 shadow-soft stretchy-scroll">
        <!-- 1. Primary Track -->
        <div id="panel-track-primary" class="track-panel space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-slate-200">
            <div>
              <span class="inline-block rounded-full bg-amber-100 px-3 py-0.5 text-xs font-semibold text-amber-900 mb-2">
                Classes 1–5 • Primary
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900">
                Primary Assessment (Classes 1–5)
              </h3>
            </div>
            <span class="inline-flex items-center gap-1.5 self-start sm:self-center rounded-full bg-white px-3.5 py-1.5 text-xs font-bold text-emerald-800 border border-slate-200 shadow-xs">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              30 Mins Duration
            </span>
          </div>

          <p class="text-sm sm:text-base leading-relaxed text-slate-700">
            Playful visual riddles, pattern completion, and intuitive counting without test anxiety.
          </p>

          <div class="grid gap-3 sm:grid-cols-3 pt-1">
            <div class="flex items-start gap-2.5 rounded-2xl bg-white p-4 border border-slate-200/70 shadow-xs">
              <svg class="h-5 w-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <div>
                <p class="text-xs font-bold text-slate-900">Live Interactive Session</p>
                <p class="text-[11px] text-slate-500 mt-0.5">30 mins 1-on-1 discovery</p>
              </div>
            </div>
            <div class="flex items-start gap-2.5 rounded-2xl bg-white p-4 border border-slate-200/70 shadow-xs">
              <svg class="h-5 w-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <div>
                <p class="text-xs font-bold text-slate-900">Parents Welcomed to Attend</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Sit in and observe your child</p>
              </div>
            </div>
            <div class="flex items-start gap-2.5 rounded-2xl bg-white p-4 border border-slate-200/70 shadow-xs">
              <svg class="h-5 w-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <div>
                <p class="text-xs font-bold text-slate-900">Visual Spatial Reasoning</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Focus on spatial logic &amp; patterns</p>
              </div>
            </div>
          </div>

          <div class="pt-3 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-t border-slate-200">
            <a
              href="https://wa.me/918011236456?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Classes%201-5."
              class="inline-flex items-center justify-center gap-2 rounded-full bg-amber-600 hover:bg-amber-700 px-7 py-3.5 text-xs sm:text-sm font-semibold text-white shadow-soft transition-all hover:shadow-hover hover:-translate-y-0.5"
            >
              <span>Book Class 1–5 Assessment</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a href="#book-assessment" class="text-xs font-semibold text-slate-500 hover:text-slate-900 text-center sm:text-left transition">
              Or schedule via form below &darr;
            </a>
          </div>
        </div>

        <!-- 2. Middle & High Track -->
        <div id="panel-track-middle" class="track-panel hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-slate-200">
            <div>
              <span class="inline-block rounded-full bg-indigo-100 px-3 py-0.5 text-xs font-semibold text-indigo-900 mb-2">
                Classes 6–10 • Middle &amp; High School
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900">
                Middle &amp; High School (Classes 6–10)
              </h3>
            </div>
            <span class="inline-flex items-center gap-1.5 self-start sm:self-center rounded-full bg-white px-3.5 py-1.5 text-xs font-bold text-emerald-800 border border-slate-200 shadow-xs">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              30 Mins Duration
            </span>
          </div>

          <p class="text-sm sm:text-base leading-relaxed text-slate-700">
            Algebraic logic, geometry derivation, word puzzles, and fundamental number intuition.
          </p>

          <div class="grid gap-3 sm:grid-cols-3 pt-1">
            <div class="flex items-start gap-2.5 rounded-2xl bg-white p-4 border border-slate-200/70 shadow-xs">
              <svg class="h-5 w-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <div>
                <p class="text-xs font-bold text-slate-900">Live 1-on-1 Assessment</p>
                <p class="text-[11px] text-slate-500 mt-0.5">30 mins personal attention</p>
              </div>
            </div>
            <div class="flex items-start gap-2.5 rounded-2xl bg-white p-4 border border-slate-200/70 shadow-xs">
              <svg class="h-5 w-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <div>
                <p class="text-xs font-bold text-slate-900">Formula Understanding</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Assessment of Formula Understanding</p>
              </div>
            </div>
            <div class="flex items-start gap-2.5 rounded-2xl bg-white p-4 border border-slate-200/70 shadow-xs">
              <svg class="h-5 w-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <div>
                <p class="text-xs font-bold text-slate-900">Curriculum Aligned</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Aligned with CBSE, ICSE &amp; IGCSE</p>
              </div>
            </div>
          </div>

          <div class="pt-3 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 border-t border-slate-200">
            <a
              href="https://wa.me/918011236456?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Classes%206-10."
              class="inline-flex items-center justify-center gap-2 rounded-full bg-amber-600 hover:bg-amber-700 px-7 py-3.5 text-xs sm:text-sm font-semibold text-white shadow-soft transition-all hover:shadow-hover hover:-translate-y-0.5"
            >
              <span>Book Class 6–10 Assessment</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
            <a href="#book-assessment" class="text-xs font-semibold text-slate-500 hover:text-slate-900 text-center sm:text-left transition">
              Or schedule via form below &darr;
            </a>
          </div>
        </div>

        <!-- 3. Senior Secondary Track -->
        <div id="panel-track-senior" class="track-panel hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-slate-200">
            <div>
              <span class="inline-block rounded-full bg-emerald-100 px-3 py-0.5 text-xs font-semibold text-emerald-900 mb-2">
                Classes 11–12 • Senior Secondary
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-slate-900">
                Senior Secondary (Classes 11–12)
              </h3>
            </div>
            <span class="inline-flex items-center gap-1.5 self-start sm:self-center rounded-full bg-white px-3.5 py-1.5 text-xs font-bold text-emerald-800 border border-slate-200 shadow-xs">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              30 Mins Duration
            </span>
          </div>

          <p class="text-sm sm:text-base leading-relaxed text-slate-700">
            Evaluating intuition in calculus, trigonometry, coordinate geometry, and problem attack strategy.
          </p>

