  <!-- Interactive Script for Form submission to WhatsApp -->
  <script is:inline>
    function initAdmissionForm() {
      const form = document.getElementById("assessment-form");
      const submitBtn = document.getElementById("btn-whatsapp-submit");

      function handleSubmit(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }

        const studentName = document.getElementById("student-name");
        const studentGrade = document.getElementById("student-grade");
        const parentPhone = document.getElementById("parent-phone");
        const preferredTime = document.getElementById("preferred-time");

        const nameVal = studentName?.value?.trim() || "";
        const gradeVal = studentGrade?.value?.trim() || "";
        const phoneVal = parentPhone?.value?.trim() || "";
        const timeVal = preferredTime?.value?.trim() || "Flexible / Any time";

        let message = "Hi NPconscious team,\n\nI would like to book a free 30-minute assessment session for my child.";
        if (nameVal) message += "\n\n*Student Name:* " + nameVal;
        if (gradeVal) message += "\n*Grade / Level:* " + gradeVal;
        if (phoneVal) message += "\n*Parent WhatsApp:* " + phoneVal;
        if (timeVal && timeVal !== "Flexible / Anytime") message += "\n*Preferred Slot:* " + timeVal;

        const waUrl = "https://wa.me/918088276492?text=" + encodeURIComponent(message);

        try {
          const win = window.open(waUrl, "_blank");
          if (!win || win.closed || typeof win.closed === "undefined") {
            window.location.href = waUrl;
          }
        } catch (err) {
          window.location.href = waUrl;
        }
      }

      if (form) {
        form.onsubmit = handleSubmit;
      }
      if (submitBtn) {
        submitBtn.onclick = handleSubmit;
      }
    }

    initAdmissionForm();
    document.addEventListener("astro:page-load", initAdmissionForm);

    function alignMountainImage() {
      const marker = document.getElementById('child-l-marker');
      const backdrop = document.getElementById('admission-mountain-backdrop');
      const container = document.getElementById('admission-hero-container');
      if (marker && backdrop && container) {
        const markerRect = marker.getBoundingClientRect();
        const containerRect = container.getBoundingClientRect();
        const leftOffset = markerRect.left - containerRect.left;
        backdrop.style.left = `${Math.round(leftOffset)}px`;
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', alignMountainImage);
    } else {
      alignMountainImage();
    }
    window.addEventListener('resize', alignMountainImage);
    document.addEventListener('astro:page-load', alignMountainImage);
  </script>
