  <script is:inline>
    function initAdmissionForm() {
      const form = document.getElementById("assessment-form");
      const submitBtn = document.getElementById("btn-whatsapp-submit");

      function handleSubmit(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }

        const studentName = document.getElementById("student-name");
        const studentGrade = document.getElementById("student-grade");
        const parentPhone = document.getElementById("parent-phone");
        const preferredTime = document.getElementById("preferred-time");

        const nameVal = studentName?.value?.trim() || "";
        const gradeVal = studentGrade?.value?.trim() || "";
        const phoneVal = parentPhone?.value?.trim() || "";
        const timeVal = preferredTime?.value?.trim() || "Flexible / Any time";

        let message = "Hi NPconscious team,\n\nI would like to book a free 30-minute assessment session for my child.";
        if (nameVal) message += "\n\n*Student Name:* " + nameVal;
        if (gradeVal) message += "\n*Grade / Level:* " + gradeVal;
        if (phoneVal) message += "\n*Parent WhatsApp:* " + phoneVal;
        if (timeVal && timeVal !== "Flexible / Anytime") message += "\n*Preferred Slot:* " + timeVal;

        const waUrl = "https://wa.me/918011236456?text=" + encodeURIComponent(message);

        try {
          const win = window.open(waUrl, "_blank");
          if (!win || win.closed || typeof win.closed === "undefined") {
            window.location.href = waUrl;
          }
        } catch (err) {
          window.location.href = waUrl;
        }
      }

      if (form) {
        form.onsubmit = handleSubmit;
      }
      if (submitBtn) {
        submitBtn.onclick = handleSubmit;
      }

      // Track Selector Switcher
      const trackTabs = document.querySelectorAll(".track-tab");
      const trackPanels = document.querySelectorAll(".track-panel");

      const gradeMapping = {
        primary: "Grade 1-5 (Primary)",
        middle: "Grade 6-8 (Middle School)",
        senior: "Grade 11-12 (Senior Secondary)",
        money: "Money & Mathematics (★ Most Popular)",
        eng: "Engineering Mathematics"
      };

      trackTabs.forEach((tab) => {
        tab.onclick = function (e) {
          e.preventDefault();
          const trackKey = tab.getAttribute("data-track");

          trackTabs.forEach((t) => {
            t.classList.remove("bg-white", "text-slate-900", "shadow-xs", "font-bold", "tab-spring-active");
            t.classList.add("text-slate-600");
            t.setAttribute("aria-selected", "false");
          });

          tab.classList.add("bg-white", "text-slate-900", "shadow-xs", "font-bold", "tab-spring-active");
          tab.classList.remove("text-slate-600");
          tab.setAttribute("aria-selected", "true");
          setTimeout(() => tab.classList.remove("tab-spring-active"), 300);

          trackPanels.forEach((panel) => {
            panel.classList.add("hidden");
            panel.classList.remove("tab-panel-enter");
          });

          const activePanel = document.getElementById("panel-track-" + trackKey);
          if (activePanel) {
            activePanel.classList.remove("hidden");
            activePanel.classList.add("tab-panel-enter");
          }

          const studentGradeSelect = document.getElementById("student-grade");
          if (studentGradeSelect && gradeMapping[trackKey]) {
            studentGradeSelect.value = gradeMapping[trackKey];
          }
        };
      });
    }

    initAdmissionForm();
    document.addEventListener("astro:page-load", initAdmissionForm);
  </script>
</MainLayout>
