---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Admission">
  <!-- Hero Section: Warm, Reassuring, Clear for Parents -->
  <section class="relative overflow-hidden bg-hero-texture px-4 pt-8 pb-14 sm:px-6 sm:pt-14 sm:pb-20 lg:px-8 lg:pt-16 lg:pb-24">
    <div class="mx-auto max-w-[1360px]">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <!-- Left Hero Content -->
        <div class="space-y-6 lg:col-span-7">
          <!-- Text block with blended mountain reflection backdrop -->
          <div id="admission-hero-container" class="relative">
            <!-- Blended Mountain Image Backdrop: starts horizontally from 'l' in Child's, covers half of up/down text -->
            <div 
              id="admission-mountain-backdrop"
              class="pointer-events-none absolute select-none z-0 left-[55%] sm:left-[56%] lg:left-[54%] -top-2 sm:-top-4 bottom-0 sm:bottom-1 w-[260px] sm:w-[350px] lg:w-[420px] aspect-square max-w-[430px]"
              aria-hidden="true"
            >
              <!-- Outer fade on left to smoothly start from 'l' -->
              <div 
                class="w-full h-full relative"
                style="
                  -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 8%, black 20%, black 100%);
                  mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.6) 8%, black 20%, black 100%);
                "
              >
                <!-- Inner elliptical mask to feather edges into canvas -->
                <div 
                  class="w-full h-full relative"
                  style="
                    -webkit-mask-image: radial-gradient(ellipse 75% 70% at 55% 50%, rgba(0,0,0,1) 25%, rgba(0,0,0,0.65) 55%, transparent 95%);
                    mask-image: radial-gradient(ellipse 75% 70% at 55% 50%, rgba(0,0,0,1) 25%, rgba(0,0,0,0.65) 55%, transparent 95%);
                  "
                >
                  <!-- Mountain Reflection Photo -->
                  <img 
                    src="/mountain-reflection.jpg" 
                    alt="" 
                    class="w-full h-full object-cover object-[50%_45%] opacity-80 contrast-[1.06] saturate-[1.12]"
                    loading="eager"
                    decoding="async"
                  />
                  <!-- Soft Warm Ambient Scrims to harmonize with #FAF8F5 background -->
                  <div class="absolute inset-0 bg-gradient-to-r from-[#FAF8F5]/85 via-[#FAF8F5]/25 to-transparent pointer-events-none"></div>
                  <div class="absolute inset-0 bg-gradient-to-b from-[#FAF8F5]/35 via-transparent to-[#FAF8F5]/45 pointer-events-none"></div>
                </div>
              </div>
            </div>

            <!-- Foreground Content: crisp typography elevated on top of image -->
            <div class="relative z-10 space-y-6">
              <div class="inline-flex items-center gap-2 rounded-full border border-amber-300/80 bg-amber-50/90 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-amber-900 shadow-xs backdrop-blur-sm">
                <span class="flex h-2 w-2 rounded-full bg-amber-500"></span>
                <span>Simple 3-Step Assessment</span>
              </div>

              <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl leading-[1.12] text-layer-elevated" style="text-shadow: 0 1px 3px rgba(250, 248, 245, 0.95), 0 0 20px rgba(250, 248, 245, 0.9);">
                Start Your Chi<span id="child-l-marker">l</span>d's<br />
                <span class="text-amber-600">Learning Journey</span>
              </h1>

              <p class="max-w-2xl text-base sm:text-lg leading-relaxed text-slate-700 font-medium text-layer-elevated" style="text-shadow: 0 1px 3px rgba(250, 248, 245, 0.95), 0 0 20px rgba(250, 248, 245, 0.9);">
                Every learner thinks differently. Our 30-minute assessment is completely stress-free — we focus on understanding your child's innate logic, curiosity, and learning style rather than judging marks.
              </p>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-1">
            <a
              href="#book-assessment"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-amber-600 hover:bg-amber-700 px-7 py-3.5 text-sm font-semibold text-white shadow-soft transition-all hover:shadow-hover hover:-translate-y-0.5 active:translate-y-0"
            >
              <span>Schedule Assessment</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </a>
            <a
              href="#test-details"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-800 shadow-xs transition hover:bg-slate-50 hover:border-slate-400"
            >
              <span>View Grade Formats</span>
            </a>
          </div>

          <!-- Academic Trust Chips -->
          <div class="flex flex-wrap items-center gap-2.5 pt-2 text-xs font-semibold text-slate-700">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 border border-slate-200/90 shadow-xs">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              Zero Pressure or Scoring Stigma
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 border border-slate-200/90 shadow-xs">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              Detailed Qualitative Parent Feedback
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 border border-slate-200/90 shadow-xs">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              Personalized Learning Roadmap
            </span>
          </div>
        </div>

        <!-- Right Visual: Assessment Overview Showcase Card -->
        <div class="relative lg:col-span-5">
          <div class="relative rounded-3xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-soft">
            <div class="overflow-hidden rounded-2xl bg-slate-50 border border-slate-100">
              <img
                src="/graph.webp"
                alt="3 out of 5 students fear maths - Overcoming mathsphobia with NPconscious"
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            <div class="mt-4 flex items-center justify-between text-xs font-medium text-slate-600 border-t border-slate-100 pt-3">
              <span class="inline-flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                Live 1-on-1 Guidance
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                Parents Welcomed to Join
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3-Step Admission Roadmap (Friendly Timeline) -->
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8 bg-white border-b border-slate-200/80">
    <div class="mx-auto max-w-5xl space-y-12">
      <div class="text-center space-y-3">
        <span class="inline-block rounded-full bg-slate-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-slate-700">
          How It Works
        </span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Three Easy Steps to Get Started
        </h2>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600">
          We keep the process transparent, supportive, and hassle-free for parents.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- Step 1 -->
        <div class="relative rounded-3xl border border-slate-200/90 bg-[#FAF8F5] p-7 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-800 font-bold mb-5 tabular-nums">
            01
          </div>
          <h3 class="text-lg font-bold text-slate-900">Share Student Details</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Share your child’s current grade, school board (CBSE, ICSE, IGCSE, State), and any specific math topics they find challenging.
          </p>
          <div class="mt-5 text-xs font-semibold text-amber-700 flex items-center gap-1">
            <span>Takes under 1 minute</span>
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="relative rounded-3xl border border-slate-200/90 bg-[#FAF8F5] p-7 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-100 text-indigo-800 font-bold mb-5 tabular-nums">
            02
          </div>
          <h3 class="text-lg font-bold text-slate-900">30-Min Assessment Session</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            A friendly online 1-on-1 session where we explore visual puzzles together. Zero marks pressure — just joyful problem solving.
          </p>
          <div class="mt-5 text-xs font-semibold text-indigo-700 flex items-center gap-1">
            <span>Parents are welcomed to attend</span>
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="relative rounded-3xl border border-slate-200/90 bg-[#FAF8F5] p-7 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-800 font-bold mb-5 tabular-nums">
            03
          </div>
          <h3 class="text-lg font-bold text-slate-900">Personalized Growth Roadmap</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            We share comprehensive feedback highlighting your child’s cognitive strengths and recommend the exact curriculum path for them.
          </p>
          <div class="mt-5 text-xs font-semibold text-emerald-700 flex items-center gap-1">
            <span>Tailored learning blueprint</span>
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Inline Assessment Booking Section -->
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8 bg-[#FAF8F5]" id="book-assessment">
    <div class="mx-auto max-w-3xl rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-10 shadow-soft">
      <div class="text-center space-y-2 mb-8">
        <span class="inline-block rounded-full bg-amber-100 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-amber-900">
          Quick Scheduling
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-950">
          Book Your Free Assessment Session
        </h2>
        <p class="text-sm text-slate-600">
          Fill in the details below to connect instantly on WhatsApp with our academic team.
        </p>
      </div>

      <form id="assessment-form" class="space-y-5">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="student-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Student Name
            </label>
            <input
              type="text"
              id="student-name"
              name="student-name"
              placeholder="e.g. Aarav Sharma"
              class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20"
            />
          </div>

          <div>
            <label for="student-grade" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Current Grade / Class
            </label>
            <select
              id="student-grade"
              name="student-grade"
              class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 bg-white"
            >
              <option value="">Select Grade / Program</option>
              <option value="Money & Mathematics (★ Most Popular)">Money & Mathematics (★ Most Popular)</option>
              <option value="Grade 1-5 (Primary)">Grade 1–5 (Primary Foundations)</option>
              <option value="Grade 6-8 (Middle School)">Grade 6–8 (Middle School)</option>
              <option value="Grade 9-10 (Board Prep)">Grade 9–10 (Board Exam Prep)</option>
              <option value="Grade 11-12 (Senior Secondary)">Grade 11–12 (Calculus & STEM)</option>
              <option value="Engineering Mathematics">Engineering Mathematics (B.Tech)</option>
            </select>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="parent-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Parent WhatsApp Number
            </label>
            <input
              type="tel"
              id="parent-phone"
              name="parent-phone"
              placeholder="+91 98765 43210"
              class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20"
            />
          </div>

          <div>
            <label for="preferred-time" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Preferred Time Slot
            </label>
            <select
              id="preferred-time"
              name="preferred-time"
              class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 bg-white"
            >
              <option value="Flexible / Anytime">Flexible / Any time</option>
              <option value="Weekday Evening (5 PM - 8 PM)">Weekday Evening (5 PM – 8 PM)</option>
              <option value="Weekend Morning (10 AM - 1 PM)">Weekend Morning (10 AM – 1 PM)</option>
              <option value="Weekend Afternoon (2 PM - 6 PM)">Weekend Afternoon (2 PM – 6 PM)</option>
            </select>
          </div>
        </div>

        <button
          type="button"
          id="btn-whatsapp-submit"
          class="w-full inline-flex items-center justify-center gap-2 rounded-full bg-amber-600 hover:bg-amber-700 px-6 py-4 text-sm font-semibold text-white shadow-soft transition-all hover:shadow-hover hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
        >
          <span>Continue to WhatsApp Booking</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>

        <p class="text-center text-xs text-slate-500">
          Prefer direct messaging? <a href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20an%20admission%20assessment." class="text-amber-700 font-semibold hover:underline">Click here to chat directly on WhatsApp</a>.
        </p>
      </form>
    </div>
  </section>

  <!-- Assessment Structure Details by Grade -->
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8 bg-white border-y border-slate-200/80" id="test-details">
    <div class="mx-auto max-w-[1360px]">
      <div class="text-center space-y-3 mb-12">
        <span class="inline-block rounded-full bg-slate-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-700">
          Age-Appropriate Formats
        </span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Assessment Formats by Grade
        </h2>
        <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600">
          Tailored to the developmental and cognitive milestones of each learner group.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 pt-4">
        <!-- Card 1 (Featured Signature): Money & Mathematics -->
        <article class="relative flex flex-col justify-between rounded-3xl border-2 border-amber-400 bg-gradient-to-b from-amber-50/95 via-white to-white p-7 shadow-xl shadow-amber-500/10 ring-4 ring-amber-400/20 transition-all duration-300 hover:shadow-2xl hover:-translate-y-2 lg:-translate-y-2">
          <!-- Floating Most Popular Badge -->
          <div class="absolute -top-3.5 left-6 inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-amber-600 to-amber-500 px-3.5 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-md ring-2 ring-white">
            <svg class="h-3.5 w-3.5 fill-current text-amber-200" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <span>★ Most Popular</span>
          </div>

          <div>
            <div class="flex items-center justify-between mb-4 pt-1">
              <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-900 border border-amber-200">
                Ages 12+ & Adults
              </span>
              <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                Practical Finance
              </span>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Money & Mathematics</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed font-normal">
              Scenario-based assessment measuring real-world financial acumen, compound interest logic, and strategic probability reasoning.
            </p>
            <div class="mt-6 space-y-2.5 border-t border-amber-200/80 pt-4 text-xs font-medium text-slate-700">
              <p class="flex items-center gap-2">
                <span class="flex h-4 w-4 items-center justify-center rounded-full bg-amber-100 text-amber-800 font-bold text-[10px]">✓</span>
                <span class="font-semibold text-slate-800">Real-Life Simulation Questions (30 mins)</span>
              </p>
              <p class="flex items-center gap-2">
                <span class="flex h-4 w-4 items-center justify-center rounded-full bg-amber-100 text-amber-800 font-bold text-[10px]">✓</span>
                <span class="font-semibold text-slate-800">Risk & Reward Probability Number Sense</span>
              </p>
              <p class="flex items-center gap-2">
                <span class="flex h-4 w-4 items-center justify-center rounded-full bg-amber-100 text-amber-800 font-bold text-[10px]">✓</span>
                <span class="font-semibold text-slate-800">Practical Financial Mindset Evaluation</span>
              </p>
            </div>
          </div>
          <div class="mt-8 pt-4 border-t border-amber-200/80">
            <a
              href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Money%20%26%20Mathematics."
              class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-amber-600 hover:bg-amber-700 px-4 py-3.5 text-xs sm:text-sm font-bold text-white shadow-soft transition-all hover:shadow-hover hover:-translate-y-0.5 active:translate-y-0"
            >
              <span>Book Money & Math Assessment</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </article>

        <!-- Card 2 -->
        <article class="flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-[#FAF8F5] p-7 shadow-soft transition hover:-translate-y-1 hover:shadow-hover">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800 border border-emerald-200">
                Primary
              </span>
              <span class="text-xs text-slate-500 font-medium">30 mins</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Classes 1–5</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Playful visual riddles, pattern completion, and intuitive counting without test anxiety.
            </p>
            <div class="mt-6 space-y-2.5 border-t border-slate-200/70 pt-4 text-xs font-medium text-slate-700">
              <p class="flex items-center gap-2">
                <span class="text-emerald-700 font-bold">&#10003;</span> Live Interactive Session (30 mins)
              </p>
              <p class="flex items-center gap-2">
                <span class="text-emerald-700 font-bold">&#10003;</span> Parents Welcomed to Attend
              </p>
              <p class="flex items-center gap-2">
                <span class="text-emerald-700 font-bold">&#10003;</span> Focus on Visual Spatial Reasoning
              </p>
            </div>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-200/70">
            <a
              href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Classes%201-5."
              class="inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-slate-900 hover:bg-slate-800 px-4 py-3 text-xs font-semibold text-white transition"
            >
              <span>Book Class 1–5 Assessment</span>
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>

        <!-- Card 3 -->
        <article class="flex flex-col justify-between rounded-3xl border border-slate-200/90 bg-[#FAF8F5] p-7 shadow-soft transition hover:-translate-y-1 hover:shadow-hover">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-800 border border-blue-200">
                Middle & High School
              </span>
              <span class="text-xs text-slate-500 font-medium">30 mins</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Classes 6–10</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Algebraic logic, geometry derivation, word puzzles, and fundamental number intuition.
            </p>
