---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Admission">
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-hero px-4 pt-8 pb-14 sm:px-6 sm:pt-14 sm:pb-20 lg:px-8 lg:pt-16 lg:pb-28">
    <div class="mx-auto max-w-[1360px]">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
        <!-- Left Hero Content -->
        <div class="space-y-5 lg:col-span-7">
          <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50/90 px-3.5 py-1 text-xs sm:text-sm font-semibold text-amber-900 shadow-sm backdrop-blur">
            <span class="flex h-2 w-2 rounded-full bg-amber-500"></span>
            <span>Simple 3-Step Process</span>
          </div>

          <h1 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl leading-tight">
            Start Your Child's<br />
            <span class="bg-gradient-to-r from-orange-600 via-amber-500 to-amber-600 bg-clip-text text-transparent">Learning Journey.</span>
          </h1>

          <p class="max-w-2xl text-sm sm:text-lg leading-relaxed text-slate-600">
            Every learner thinks differently. Our 30-minute diagnostic is completely stress-free — we focus on understanding their innate logic, curiosity, and learning style rather than just marks.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
            <a
              href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20an%20admission%20test.%0A%0AStudent%20Name%3A%20%0AGrade%2FClass%3A%20%0AProgram%20Name%3A%20"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-orange-500 via-amber-500 to-amber-400 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-orange-500/25 transition hover:shadow-xl hover:shadow-orange-500/35 hover:-translate-y-0.5 active:translate-y-0"
            >
              <span>Book Assessment on WhatsApp</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
            <a
              href="#test-details"
              class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-300/80 bg-white px-6 py-3.5 text-sm font-semibold text-slate-800 shadow-sm transition hover:bg-slate-50"
            >
              <span>View Structure</span>
              <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </a>
          </div>

          <!-- Stencil-inspired friendly badges -->
          <div class="flex flex-wrap items-center gap-2 pt-2 text-[11px] sm:text-xs font-medium text-slate-600">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 border border-slate-200 shadow-sm">
              <span class="text-emerald-500 font-bold">&#10003;</span> Zero Pressure
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 border border-slate-200 shadow-sm">
              <span class="text-emerald-500 font-bold">&#10003;</span> Detailed Qualitative Feedback
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 border border-slate-200 shadow-sm">
              <span class="text-emerald-500 font-bold">&#10003;</span> Customized Recommendations
            </span>
          </div>
        </div>
        </div>

        <!-- Right Visual with Slideshow -->
        <div class="relative lg:col-span-5">
          <div class="relative rounded-[2.5rem] border border-slate-200/80 bg-white p-4 shadow-soft">
            <div class="relative aspect-square sm:aspect-[4/3] overflow-hidden rounded-[2rem] bg-slate-50">
              <img
                src="/3.png"
                class="slide img-fill absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity duration-700"
                alt="NPconscious admission visual 1"
              />
              <img
                src="/21.png"
                class="slide img-fill absolute inset-0 h-full w-full object-contain bg-white opacity-0 transition-opacity duration-700 p-4"
                alt="NPconscious admission visual 2"
              />
            </div>
            <div class="mt-3 flex items-center justify-between px-2 text-xs text-slate-500">
              <span>Interactive Diagnostic</span>
              <span>1-on-1 Guidance</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3-Step Admission Roadmap (Friendly Timeline) -->
  <section class="px-6 py-20 lg:px-8">
    <div class="mx-auto max-w-5xl space-y-12">
      <div class="text-center space-y-3">
        <span class="inline-block rounded-full bg-slate-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-slate-600">
          How It Works
        </span>
        <h2 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Three Easy Steps to Get Started
        </h2>
        <p class="max-w-2xl mx-auto text-base text-slate-600">
          We keep the process transparent, supportive, and hassle-free for parents.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- Step 1 -->
        <div class="relative rounded-3xl border border-slate-200/90 bg-white p-8 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-800 text-xl font-bold mb-5">
            01
          </div>
          <h3 class="text-lg font-bold text-slate-900">Share Student Details</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Send us a quick WhatsApp message with the student’s name, current grade/class, and the program you’re interested in.
          </p>
          <div class="mt-4 text-xs font-semibold text-amber-700">
            Takes under 1 minute &rarr;
          </div>
        </div>

        <!-- Step 2 -->
        <div class="relative rounded-3xl border border-slate-200/90 bg-white p-8 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-100 text-indigo-800 text-xl font-bold mb-5">
            02
          </div>
          <h3 class="text-lg font-bold text-slate-900">30-Min Diagnostic Chat</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            A friendly live online session where we explore concepts together. No stressful scoring — just joyful problem solving.
          </p>
          <div class="mt-4 text-xs font-semibold text-indigo-700">
            Parent attendance welcomed &rarr;
          </div>
        </div>

        <!-- Step 3 -->
        <div class="relative rounded-3xl border border-slate-200/90 bg-white p-8 shadow-soft transition hover:-translate-y-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-800 text-xl font-bold mb-5">
            03
          </div>
          <h3 class="text-lg font-bold text-slate-900">Personalized Roadmap</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            We share comprehensive feedback highlighting your child’s conceptual strengths and suggest the ideal batch or curriculum path.
          </p>
          <div class="mt-4 text-xs font-semibold text-emerald-700">
            Tailored learning path &rarr;
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Assessment Structure Details -->
  <section class="px-4 sm:px-6 py-20 lg:px-8" id="test-details">
    <div class="mx-auto max-w-[1360px] rounded-[3rem] bg-gradient-to-br from-indigo-50/70 via-purple-50/40 to-amber-50/70 p-8 sm:p-12 lg:p-16 border border-slate-200/60 shadow-soft">
      <div class="text-center space-y-3 mb-14">
        <span class="inline-block rounded-full bg-white px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-purple-700 shadow-sm border border-purple-100">
          Curriculum & Grades
        </span>
        <h2 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          Assessment Formats by Grade
        </h2>
        <p class="max-w-2xl mx-auto text-base text-slate-600">
          Tailored to the developmental and cognitive milestones of each age group.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Card 1 -->
        <article class="flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 border border-emerald-200">
                Primary
              </span>
              <span class="text-xs text-slate-400 font-medium">30 mins</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Classes 1–5</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Playful visual riddles, pattern completion, and intuitive counting.
            </p>
            <div class="mt-6 space-y-2 border-t border-slate-100 pt-4 text-xs font-medium text-slate-600">
              <p class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">&#8226;</span> Live Interactive Session (30 mins)
              </p>
              <p class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">&#8226;</span> Parent Required to Attend
              </p>
              <p class="flex items-center gap-2">
                <span class="text-slate-400 font-bold">&#8226;</span> Calculator Not Allowed
              </p>
            </div>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100">
            <a
              href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Classes%201-5."
              class="inline-flex w-full items-center justify-center rounded-full bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-slate-800"
            >
              Book Class 1–5 Slot &rarr;
            </a>
          </div>
        </article>

        <!-- Card 2 -->
        <article class="flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 border border-blue-200">
                Middle & High School
              </span>
              <span class="text-xs text-slate-400 font-medium">30 mins</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Classes 6–10</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Algebraic logic, spatial thinking, word puzzles, and arithmetic patterns.
            </p>
            <div class="mt-6 space-y-2 border-t border-slate-100 pt-4 text-xs font-medium text-slate-600">
              <p class="flex items-center gap-2">
                <span class="text-blue-500 font-bold">&#8226;</span> Live 1-on-1 Test (30 mins)
              </p>
              <p class="flex items-center gap-2">
                <span class="text-blue-500 font-bold">&#8226;</span> Parent Optional
              </p>
              <p class="flex items-center gap-2">
                <span class="text-slate-400 font-bold">&#8226;</span> Focus on Conceptual Clarity
              </p>
            </div>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100">
            <a
              href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Classes%206-10."
              class="inline-flex w-full items-center justify-center rounded-full bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-slate-800"
            >
              Book Class 6–10 Slot &rarr;
            </a>
          </div>
        </article>

        <!-- Card 3 -->
        <article class="flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="rounded-full bg-violet-50 px-3 py-1 text-xs font-semibold text-violet-700 border border-violet-200">
                Senior Secondary
              </span>
              <span class="text-xs text-slate-400 font-medium">30 mins</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Classes 11–12</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Evaluating intuition in calculus, trigonometry, coordinate geometry, and functions.
            </p>
            <div class="mt-6 space-y-2 border-t border-slate-100 pt-4 text-xs font-medium text-slate-600">
              <p class="flex items-center gap-2">
                <span class="text-violet-500 font-bold">&#8226;</span> Live Diagnostic (30 mins)
              </p>
              <p class="flex items-center gap-2">
                <span class="text-violet-500 font-bold">&#8226;</span> Entrance / Board Readiness Check
              </p>
              <p class="flex items-center gap-2">
                <span class="text-slate-400 font-bold">&#8226;</span> Formula Intuition Review
              </p>
            </div>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100">
            <a
              href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Classes%2011-12."
              class="inline-flex w-full items-center justify-center rounded-full bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-slate-800"
            >
              Book Class 11–12 Slot &rarr;
            </a>
          </div>
        </article>

        <!-- Card 4 -->
        <article class="flex flex-col justify-between rounded-3xl border border-slate-200 bg-white p-7 shadow-soft transition hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 border border-slate-200">
                Undergraduate
              </span>
              <span class="text-xs text-slate-400 font-medium">1 Hour</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Engineering Mathematics</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Higher-order problem solving for engineering coursework and technical exams.
            </p>
            <div class="mt-6 space-y-2 border-t border-slate-100 pt-4 text-xs font-medium text-slate-600">
              <p class="flex items-center gap-2">
                <span class="text-slate-600 font-bold">&#8226;</span> Written Problem Set (1 Hour)
              </p>
              <p class="flex items-center gap-2">
                <span class="text-slate-600 font-bold">&#8226;</span> Deep Evaluation of Calculus & Linear Algebra
              </p>
            </div>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100">
            <a
              href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Engineering%20Mathematics."
              class="inline-flex w-full items-center justify-center rounded-full bg-slate-900 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-slate-800"
            >
              Book Engineering Slot &rarr;
            </a>
          </div>
        </article>

        <!-- Card 5 (Featured) -->
        <article class="relative flex flex-col justify-between rounded-3xl border-2 border-amber-300 bg-gradient-to-b from-amber-50/90 to-white p-7 shadow-soft transition hover:-translate-y-1">
          <div class="absolute -top-3.5 right-6 rounded-full bg-gradient-to-r from-orange-500 to-amber-500 px-3.5 py-1 text-[11px] font-bold uppercase tracking-wider text-white shadow-md">
            ⭐ Popular
          </div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900">
                Financial Thinking
              </span>
              <span class="text-xs text-amber-700 font-medium">All Ages</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Money & Mathematics</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              MSQ-based assessment measuring real-world financial acumen and number sense.
            </p>
            <div class="mt-6 space-y-2 border-t border-amber-100 pt-4 text-xs font-medium text-slate-600">
              <p class="flex items-center gap-2">
                <span class="text-amber-600 font-bold">&#8226;</span> Scenario-based MSQ Questions
              </p>
              <p class="flex items-center gap-2">
                <span class="text-amber-600 font-bold">&#8226;</span> Risk & Reward Reasoning
              </p>
            </div>
          </div>
          <div class="mt-8 pt-4 border-t border-amber-100">
            <a
              href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20an%20assessment%20for%20Money%20%26%20Mathematics."
              class="inline-flex w-full items-center justify-center rounded-full bg-gradient-to-r from-orange-500 to-amber-400 px-4 py-2.5 text-xs font-semibold text-white shadow transition hover:opacity-95"
            >
              Book Money & Math Slot &rarr;
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Helpful Tips Pill Card -->
  <section class="px-6 py-12 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-2xl border border-amber-200 bg-amber-50/70 p-6 sm:p-8 text-center text-amber-900 shadow-sm flex flex-col sm:flex-row items-center justify-center gap-4">
      <span class="text-3xl">⏰</span>
      <div class="text-left">
        <p class="font-bold text-sm sm:text-base">Quick Reminder for Test Day:</p>
        <p class="text-xs sm:text-sm text-amber-800">
          Please join 5 minutes before your scheduled slot with a notebook and a pen. No special preparation or memorization is required!
        </p>
      </div>
    </div>
  </section>

  <!-- Transparency & Trust Card -->
  <section class="px-6 py-16 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-3xl border border-slate-200 bg-white p-8 sm:p-12 shadow-soft">
      <div class="flex items-center gap-3 mb-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 font-bold text-lg">
          🛡️
        </div>
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Our Pledge</span>
          <h2 class="text-2xl font-bold text-slate-900">Transparency & Trust First</h2>
        </div>
      </div>
      <p class="text-base leading-relaxed text-slate-600">
        At NPconscious, integrity is fundamental. We do not charge surprise registration fees or hidden charges outside officially communicated programs.
      </p>
      <p class="mt-4 text-base leading-relaxed text-slate-600">
        Any official communication or payment link is provided exclusively through our verified channels. If you have any doubts, reach out directly to us at:
      </p>
      <div class="mt-6 flex w-full flex-col items-start gap-2 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-xs font-semibold text-slate-900 sm:w-fit sm:flex-row sm:items-center sm:gap-2 sm:px-5 sm:text-sm">
        <span>✉️</span>
        <a href="mailto:npconscious@gmail.com" class="break-all text-amber-600 hover:underline">npconscious@gmail.com</a>
        <span class="hidden text-slate-400 sm:inline">&bull;</span>
        <a href="tel:+918088276492" class="whitespace-nowrap text-slate-700 hover:underline">+91 80882 76492</a>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="px-6 py-16 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-[3rem] bg-gradient-to-r from-slate-900 via-slate-950 to-slate-900 p-10 sm:p-16 text-center text-white shadow-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Ready to Discover Your Child’s Potential?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-slate-300 leading-relaxed">
        Send your child's details to schedule a relaxed 30-minute diagnostic session with our academic team.
      </p>
      <a
        href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20an%20admission%20test.%0A%0AStudent%20Name%3A%20%0AGrade%2FClass%3A%20%0AProgram%20Name%3A%20"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-orange-500 to-amber-400 px-8 py-4 text-sm font-semibold text-white shadow-lg transition hover:scale-105"
      >
        <span>Schedule on WhatsApp</span>
        <span>&rarr;</span>
      </a>
    </div>
  </section>

  <!-- Slideshow Script -->
  <script is:inline>
    const slides = document.querySelectorAll(".slide");
    if (slides && slides.length > 1) {
      let index = 0;
      setInterval(() => {
        slides[index].classList.remove("opacity-100");
        slides[index].classList.add("opacity-0");
        index = (index + 1) % slides.length;
        slides[index].classList.remove("opacity-0");
        slides[index].classList.add("opacity-100");
      }, 5000);
    }
  </script>
</MainLayout>
