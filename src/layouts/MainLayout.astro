        <a href="/" class="inline-flex items-center gap-3 group" aria-label="NPconscious home">
          <img
            src="/site.webp"
            alt="NPconscious logo"
            class="h-7 w-auto object-contain md:h-8 transition-transform group-hover:scale-[1.02]"
          />
