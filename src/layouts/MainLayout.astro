    <!-- Interactive Mobile Nav Script (idempotent, re-binds cleanly with View Transitions) -->
    <script is:inline>
      function initMobileMenu() {
        const toggleBtn = document.getElementById("mobile-nav-toggle");
        const closeBtn = document.getElementById("mobile-nav-close");
        const drawer = document.getElementById("mobile-navigation");
        const overlay = document.getElementById("mobile-nav-overlay");

        if (!toggleBtn || !drawer || !overlay) return;

        function openMenu() {
          toggleBtn.setAttribute("aria-expanded", "true");
          drawer.classList.add("is-open");
          overlay.classList.add("is-open");
          document.body.style.overflow = "hidden";
        }

        function closeMenu() {
          toggleBtn.setAttribute("aria-expanded", "false");
          drawer.classList.remove("is-open");
          overlay.classList.remove("is-open");
          document.body.style.overflow = "";
        }

        toggleBtn.onclick = function (e) {
          e.preventDefault();
          e.stopPropagation();
          const isOpen = toggleBtn.getAttribute("aria-expanded") === "true";
          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        };

        if (closeBtn) {
          closeBtn.onclick = function (e) {
            e.preventDefault();
            closeMenu();
          };
        }

        overlay.onclick = function (e) {
          e.preventDefault();
          closeMenu();
        };

        // Close when clicking any link inside the mobile drawer
        drawer.querySelectorAll("a").forEach(function (link) {
          link.onclick = function () {
            closeMenu();
          };
        });

        // Close on Escape key
        document.onkeydown = function (e) {
          if (e.key === "Escape" && toggleBtn.getAttribute("aria-expanded") === "true") {
            closeMenu();
          }
        };
      }

      // Initialize on direct script execution
      initMobileMenu();

      // Re-initialize after Astro ClientRouter view transitions
      document.addEventListener("astro:page-load", initMobileMenu);
    </script>
  </body>
</html>
