---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
const { title } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isFounder = pathname.startsWith("/founder");
const isAdmission = pathname.startsWith("/admission");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} · NPconscious` : "NPconscious · Making Mathematics Natural Again"}</title>
    <meta
      name="description"
      content="NPconscious helps students build unbreakable fundamentals through curiosity, questioning, and visual exploration — replacing rote memorization with joyful mathematical mastery."
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <style is:global>
      #mobile-navigation {
        transform: translateX(100%);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      #mobile-navigation.is-open {
        transform: translateX(0) !important;
      }
      #mobile-nav-overlay {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.3s ease, visibility 0.3s ease;
      }
      #mobile-nav-overlay.is-open {
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
      }

      /* Silky-smooth initial page load entrance */
      @keyframes page-enter {
        0% {
          opacity: 0;
          transform: translateY(8px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .page-enter-animation {
        animation: page-enter 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      /* High-performance View Transitions across client-side page changes */
      ::view-transition-old(root) {
        animation: 160ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out;
      }
      ::view-transition-new(root) {
        animation: 260ms cubic-bezier(0, 0, 0.2, 1) both vt-fade-in;
      }

      @keyframes vt-fade-out {
        from {
          opacity: 1;
          transform: translateY(0);
        }
        to {
          opacity: 0;
          transform: translateY(-4px);
        }
      }

      @keyframes vt-fade-in {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .page-enter-animation,
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body class="bg-[#FAF8F5] text-slate-900 selection:bg-amber-200 selection:text-slate-950 antialiased" id="top">
    <!-- Top Announcement Bar: High-trust, warm academic invitation for parents -->
    <div class="relative z-50 flex items-center justify-center gap-2 bg-slate-900 px-4 py-2 text-center text-xs font-medium text-slate-200">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/20 px-2.5 py-0.5 text-[11px] font-semibold text-amber-300 border border-amber-500/30">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
        Admissions Open 2026
      </span>
      <a
        href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20a%20free%20demo%20session!"
        class="ml-1 inline-flex items-center gap-1 font-semibold text-amber-400 hover:text-amber-300 transition-colors underline underline-offset-2"
      >
        <span>Reserve Spot</span>
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Header: clean full-width sticky bar on mobile, floating rounded pill on desktop -->
    <header class="sticky top-0 z-40 md:top-3 md:px-6 lg:px-8" style="view-transition-name: site-header;">
      <div
        class="mx-auto flex max-w-[1320px] items-center justify-between gap-4 border-b border-slate-200/80 bg-white/95 px-4 py-3 backdrop-blur-md transition-all duration-300 md:rounded-full md:border md:px-6 md:shadow-soft"
