---
import "../styles/global.css";
const { title } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isFounder = pathname.startsWith("/founder");
const isAdmission = pathname.startsWith("/admission");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} · NPconscious` : "NPconscious · Making Mathematics Natural Again"}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#f8fafc] text-slate-900 selection:bg-amber-200 selection:text-slate-950">
    <!-- Top announcement bar for a warm, welcoming vibe -->
    <div class="bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 px-4 py-2 text-center text-xs sm:text-sm font-medium text-white shadow-inner flex items-center justify-center gap-2">
      <span class="inline-block animate-bounce">✨</span>
      <span>Admissions Open for 2026 Batch — Book a Free 1-on-1 Curiosity Math Demo!</span>
      <a href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20a%20free%20demo%20session!" class="underline font-semibold hover:text-amber-100 hidden sm:inline ml-1">Claim Spot &rarr;</a>
    </div>

    <!-- Header with floating pill styling -->
    <header class="sticky top-3 z-40 px-4 sm:px-6 lg:px-8">
      <div
        class="mx-auto flex max-w-[1320px] items-center justify-between gap-4 rounded-full border border-slate-200/80 bg-white/90 px-5 py-3 shadow-soft backdrop-blur-md transition-all duration-300"
      >
        <a href="/" class="inline-flex items-center gap-3 group" aria-label="NPconscious home">
          <img
            src="/site.png"
            alt="NPconscious"
            class="h-8 w-auto object-contain md:h-9 transition-transform group-hover:scale-105"
          />
        </a>

        <!-- Desktop Navigation with friendly pill states -->
        <div class="hidden items-center gap-2 md:flex">
          <nav
            class="flex items-center gap-1 text-sm font-medium text-slate-700 bg-slate-100/80 p-1.5 rounded-full border border-slate-200/60"
            aria-label="Primary navigation"
          >
            <a
              href="/"
              class={`px-4 py-2 rounded-full transition-all duration-200 ${
                isHome
                  ? "bg-white text-slate-950 shadow-sm font-semibold"
                  : "text-slate-600 hover:text-slate-950 hover:bg-white/60"
              }`}
              >Home</a
            >
            <a
              href="/founder"
              class={`px-4 py-2 rounded-full transition-all duration-200 ${
                isFounder
                  ? "bg-white text-slate-950 shadow-sm font-semibold"
                  : "text-slate-600 hover:text-slate-950 hover:bg-white/60"
              }`}
              >Our Vision</a
            >
            <a
              href="/admission"
              class={`px-4 py-2 rounded-full transition-all duration-200 ${
                isAdmission
                  ? "bg-white text-slate-950 shadow-sm font-semibold"
                  : "text-slate-600 hover:text-slate-950 hover:bg-white/60"
              }`}
              >Admission</a
            >
          </nav>

          <a
            href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20a%20free%20demo%20session!"
            class="ml-2 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-orange-500 via-amber-500 to-amber-400 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-orange-500/20 transition-all hover:shadow-lg hover:shadow-orange-500/30 hover:-translate-y-0.5 active:translate-y-0"
          >
            <span>Book Free Demo</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>

        <!-- Mobile Toggle Button -->
        <button
          id="mobile-nav-toggle"
          type="button"
          aria-controls="mobile-navigation"
          aria-expanded="false"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-800 shadow-sm transition hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 md:hidden"
        >
          <span class="sr-only">Open navigation menu</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Mobile Nav Overlay -->
    <div
      id="mobile-nav-overlay"
      class="fixed inset-0 z-40 hidden bg-slate-950/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 md:hidden"
    >
    </div>

    <!-- Mobile Navigation Drawer -->
    <aside
      id="mobile-navigation"
      class="fixed inset-y-0 right-0 z-50 flex w-full max-w-xs translate-x-full flex-col border-l border-slate-200 bg-white p-6 shadow-2xl transition-transform duration-300 md:hidden overflow-y-auto"
      aria-label="Mobile navigation"
    >
      <div class="mb-8 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <img src="/site.png" alt="NPconscious" class="h-7 w-auto object-contain" />
        </div>
        <button
          id="mobile-nav-close"
          type="button"
          aria-label="Close navigation menu"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-slate-50 text-slate-800 transition hover:bg-slate-100"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
          >
            <path d="M6 6l12 12M6 18L18 6"></path>
          </svg>
        </button>
      </div>

      <nav
        class="flex flex-col gap-2 text-base font-medium text-slate-800"
        aria-label="Mobile navigation links"
      >
        <a
          href="/"
          class={`rounded-2xl px-4 py-3 transition ${
            isHome ? "bg-amber-50 text-amber-900 font-semibold border border-amber-200" : "bg-slate-50 hover:bg-slate-100 text-slate-800"
          }`}
          >Home</a
        >
        <a
          href="/founder"
          class={`rounded-2xl px-4 py-3 transition ${
            isFounder ? "bg-amber-50 text-amber-900 font-semibold border border-amber-200" : "bg-slate-50 hover:bg-slate-100 text-slate-800"
          }`}
          >Our Vision</a
        >
        <a
          href="/admission"
          class={`rounded-2xl px-4 py-3 transition ${
            isAdmission ? "bg-amber-50 text-amber-900 font-semibold border border-amber-200" : "bg-slate-50 hover:bg-slate-100 text-slate-800"
          }`}
          >Admission</a
        >
      </nav>

      <div class="mt-8 rounded-2xl bg-amber-50 p-4 border border-amber-100 text-center">
        <p class="text-xs font-semibold uppercase tracking-wider text-amber-800">Need Guidance?</p>
        <p class="mt-1 text-sm text-amber-900">Talk directly with our academic advisor</p>
        <a
          href="https://wa.me/918088276492?text=Hi%2C%20I%20would%20like%20to%20book%20a%20free%20demo%20session!"
          class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-orange-500 to-amber-400 px-5 py-3 text-sm font-semibold text-white shadow-md transition hover:-translate-y-0.5"
        >
          <span>Book Free Demo</span>
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main aria-label="Main content">
      <slot />
    </main>

    <!-- Floating WhatsApp Action -->
    <aside aria-label="Contact via WhatsApp" class="fixed bottom-6 right-6 z-40">
      <a
        href="https://wa.me/918088276492?text=Hi%20NPconscious%20team%2C%20I%20have%20a%20question%20about%20your%20maths%20programs."
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat on WhatsApp"
        class="group flex items-center gap-2.5 rounded-full bg-[#25D366] px-4 py-3 text-white shadow-lg shadow-emerald-500/30 transition-all hover:scale-105 hover:bg-[#20ba5a] active:scale-95"
      >
        <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span class="text-sm font-semibold pr-1">Chat on WhatsApp</span>
      </a>
    </aside>

    <!-- Rich, Friendly Footer (Inspired by modern educational platforms) -->
    <footer class="mt-20 border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-[1320px] px-6 py-16 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-4">
          <!-- Col 1: Brand Info -->
          <div class="space-y-4 lg:col-span-2">
            <div class="flex items-center gap-3">
              <img src="/site.png" alt="NPconscious" class="h-9 w-auto object-contain" />
            </div>
            <p class="max-w-md text-base leading-relaxed text-slate-600">
              Making Mathematics Natural Again. We cultivate genuine mathematical intuition and curiosity instead of mechanical rote learning.
            </p>
            <div class="pt-2 flex flex-wrap items-center gap-3">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 border border-emerald-200">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span> 100% Student-First
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800 border border-amber-200">
                ⭐ 160+ Happy Students
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 border border-indigo-200">
                🎓 Qualified Mentors
              </span>
            </div>
          </div>

          <!-- Col 2: Navigation Links -->
          <div class="space-y-4">
            <p class="text-sm font-semibold uppercase tracking-wider text-slate-900">Explore</p>
            <ul class="space-y-2.5 text-sm font-medium text-slate-600">
              <li>
                <a href="/" class="hover:text-amber-600 transition flex items-center gap-1.5">
                  <span class="text-amber-500">&bull;</span> Home
                </a>
              </li>
              <li>
                <a href="/founder" class="hover:text-amber-600 transition flex items-center gap-1.5">
                  <span class="text-amber-500">&bull;</span> Our Vision & Philosophy
                </a>
              </li>
              <li>
                <a href="/admission" class="hover:text-amber-600 transition flex items-center gap-1.5">
                  <span class="text-amber-500">&bull;</span> Admission Assessment
                </a>
              </li>
              <li>
                <a href="/#programs" class="hover:text-amber-600 transition flex items-center gap-1.5">
                  <span class="text-amber-500">&bull;</span> Programs & Pricing
                </a>
              </li>
            </ul>
          </div>

          <!-- Col 3: Direct Contact -->
          <div class="space-y-4">
            <p class="text-sm font-semibold uppercase tracking-wider text-slate-900">Get In Touch</p>
            <div class="space-y-3 text-sm text-slate-600">
              <p class="flex items-center gap-2.5">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 text-slate-700">📞</span>
                <a href="tel:+918088276492" class="hover:text-amber-600 font-medium">+91 80882 76492</a>
              </p>
              <p class="flex items-center gap-2.5">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-100 text-slate-700">✉️</span>
                <a href="mailto:npconscious@gmail.com" class="hover:text-amber-600 font-medium">npconscious@gmail.com</a>
              </p>
              <p class="flex items-center gap-2.5">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">💬</span>
                <a href="https://wa.me/918088276492" class="hover:text-emerald-600 font-medium">WhatsApp Support</a>
              </p>
            </div>
            <p class="text-xs text-slate-400">Response time: Usually within 2 hours</p>
          </div>
        </div>

        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-100 pt-8 text-center text-xs text-slate-500 sm:flex-row">
          <p>© 2026 NPconscious. All rights reserved.</p>
          <div class="flex items-center gap-6">
            <span>Built with Curiosity & Heart</span>
            <a href="#top" class="hover:text-slate-900 font-medium">Back to Top &uarr;</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Interactive Scripts -->
    <script is:inline>
      const menuToggle = document.getElementById("mobile-nav-toggle");
      const menuClose = document.getElementById("mobile-nav-close");
      const menu = document.getElementById("mobile-navigation");
      const overlay = document.getElementById("mobile-nav-overlay");

      const openMenu = () => {
        menuToggle?.setAttribute("aria-expanded", "true");
        menu?.classList.remove("translate-x-full");
        overlay?.classList.remove("hidden", "opacity-0");
        overlay?.classList.add("opacity-100");
        document.body.classList.add("overflow-hidden");
      };

      const closeMenu = () => {
        menuToggle?.setAttribute("aria-expanded", "false");
        menu?.classList.add("translate-x-full");
        overlay?.classList.add("opacity-0");
        overlay?.classList.remove("opacity-100");
        document.body.classList.remove("overflow-hidden");
        setTimeout(() => overlay?.classList.add("hidden"), 300);
      };

      if (menuToggle && menu && overlay) {
        menuToggle.addEventListener("click", () => {
          const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        });
      }

      if (menuClose && overlay) {
        menuClose.addEventListener("click", closeMenu);
        overlay.addEventListener("click", closeMenu);
      }
    </script>
  </body>
</html>

