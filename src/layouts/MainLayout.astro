---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isMaths = pathname.startsWith("/mathematics");
const isCs = pathname.startsWith("/computer-science");
const isGuidance = pathname.startsWith("/career-guidance");
const isFounder = pathname.startsWith("/founder");
const isAdmission = pathname.startsWith("/admission");

const pageTitle = title
  ? `${title} · NPconscious`
  : "NPconscious · A Sanctuary for Young Minds";
const pageDescription =
  description ||
  "NPconscious is a student-friendly sanctuary for young minds offering Mathematics, Computer Science, and free Career Guidance, listening first to help every learner find their right next step.";

const navItems = [
  { href: "/", label: "Home", active: isHome },
  { href: "/mathematics", label: "Mathematics", active: isMaths },
  { href: "/computer-science", label: "Computer Science", active: isCs },
  { href: "/career-guidance", label: "Career Guidance", active: isGuidance, badge: "Free" },
  { href: "/founder", label: "Our Vision", active: isFounder },
  { href: "/admission", label: "Admission", active: isAdmission },
];

const directSupportEmails = [
  {
    label: "HELP & SUPPORT",
    email: "help@npconscious.com",
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=help@npconscious.com",
  },
  {
    label: "ADMISSIONS",
    email: "admission@npconscious.com",
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=admission@npconscious.com",
  },
  {
    label: "ADMINISTRATION",
    email: "admin@npconscious.com",
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=admin@npconscious.com",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <style is:global>
      #site-nav-pill {
        transition:
          background-color var(--duration-nav) var(--ease-sanctuary),
          backdrop-filter var(--duration-nav) var(--ease-sanctuary),
          box-shadow var(--duration-nav) var(--ease-sanctuary),
          border-color var(--duration-nav) var(--ease-sanctuary);
      }

      #site-nav-pill.is-scrolled {
        background-color: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(12px);
        box-shadow: var(--shadow-nav-scrolled);
        border-color: var(--border-strong);
      }

      #mobile-navigation {
        transform: translateX(100%);
        transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1);
      }

      #mobile-navigation.is-open {
        transform: translateX(0);
      }

      #mobile-nav-overlay {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 240ms ease, visibility 240ms ease;
      }

      #mobile-nav-overlay.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      ::view-transition-old(root) {
        animation: 160ms ease-out both vt-fade-out;
      }

      ::view-transition-new(root) {
        animation: 240ms var(--ease-sanctuary) both vt-fade-in;
      }

      @keyframes vt-fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }

      @keyframes vt-fade-in {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .footer-link,
      .footer-link:visited {
        color: var(--text-primary);
        transition: color 150ms ease, text-decoration-color 150ms ease;
      }

      .footer-link:hover,
      .footer-link:visited:hover,
      .footer-link:focus-visible {
        color: var(--accent-sage);
      }

      @media (prefers-reduced-motion: reduce) {
        #site-nav-pill,
        #mobile-navigation,
        #mobile-nav-overlay,
        .footer-link,
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>

  <body class="bg-[var(--bg-secondary)] text-[var(--text-primary)] antialiased" id="top">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-[var(--cta-primary)] focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to main content
    </a>

    <!-- Floating Pill Header -->
    <header class="sticky top-4 z-40 px-4 sm:px-5 lg:px-8" style="view-transition-name: site-header;">
      <div
        id="site-nav-pill"
        class="container-nav flex h-[55px] items-center justify-between gap-3 rounded-full border border-[var(--border-subtle)] bg-white pl-5 pr-2 lg:pl-8 lg:pr-2 shadow-[var(--shadow-subtle)]"
      >
        <a href="/" class="inline-flex items-center shrink-0" aria-label="NPconscious home">
          <picture>
            <source srcset="/site.webp" type="image/webp" />
            <img
              src="/site.png"
              alt="NPconscious logo"
              class="h-6 sm:h-7 w-auto object-contain"
              width="1019"
              height="316"
              loading="eager"
              decoding="async"
              onerror="this.onerror=null; this.src='/site.png';"
            />
          </picture>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-1 text-sm" aria-label="Primary navigation">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={`inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 font-medium transition-colors ${
                  item.active
                    ? "bg-[var(--bg-secondary)] text-[var(--text-primary)] font-semibold"
                    : "text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-elevated-soft)]"
                }`}
              >
                <span>{item.label}</span>
                {item.badge && (
                  <span class="rounded-full bg-[var(--accent-sage-soft)] px-2 py-0.5 text-[11px] font-semibold text-[var(--accent-sage)]">
                    {item.badge}
                  </span>
                )}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="/admission"
            class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-[var(--cta-primary)] px-4 py-2 text-xs font-medium text-white shadow-[0_2px_0_0_#000] transition duration-100 hover:bg-[var(--cta-primary-hover)] hover:translate-y-[0.5px] active:translate-y-[2px] active:shadow-none"
          >
            <span>Book Conversation</span>
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Mobile Toggle Button -->
          <button
            id="mobile-nav-toggle"
            type="button"
            aria-controls="mobile-navigation"
            aria-expanded="false"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-[var(--bg-elevated-soft)] text-[var(--text-primary)] transition hover:bg-[var(--bg-sand-soft)] lg:hidden cursor-pointer"
          >
            <span class="sr-only">Open navigation menu</span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Nav Overlay -->
    <div
      id="mobile-nav-overlay"
      class="fixed inset-0 z-40 bg-black/35 backdrop-blur-[2px] lg:hidden"
    ></div>

    <!-- Mobile Navigation Drawer -->
    <aside
      id="mobile-navigation"
      class="fixed inset-y-0 right-0 z-50 flex w-full max-w-xs flex-col overflow-y-auto border-l border-[var(--border-subtle)] bg-white p-6 shadow-2xl lg:hidden"
      aria-label="Mobile navigation"
    >
      <div class="mb-7 flex items-center justify-between">
        <picture>
          <source srcset="/site.webp" type="image/webp" />
          <img
            src="/site.png"
            alt="NPconscious"
            class="h-7 w-auto object-contain"
            onerror="this.onerror=null; this.src='/site.png';"
          />
        </picture>
        <button
          id="mobile-nav-close"
          type="button"
          aria-label="Close navigation menu"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[var(--border-subtle)] bg-[var(--bg-elevated-soft)] text-[var(--text-primary)] transition hover:bg-[var(--bg-sand-soft)] cursor-pointer"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M6 18L18 6" />
          </svg>
        </button>
      </div>

      <nav class="flex flex-col gap-1.5 text-sm font-medium" aria-label="Mobile navigation links">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`flex items-center justify-between rounded-2xl px-4 py-3 transition ${
                item.active
                  ? "bg-[var(--bg-secondary)] border border-[var(--border-subtle)] text-[var(--text-primary)] font-semibold"
                  : "text-[var(--text-secondary)] hover:bg-[var(--bg-elevated-soft)]"
              }`}
            >
              <span>{item.label}</span>
              {item.badge && (
                <span class="rounded-full bg-[var(--accent-sage-soft)] px-2.5 py-0.5 text-[11px] font-semibold text-[var(--accent-sage)]">
                  {item.badge}
                </span>
              )}
            </a>
          ))
        }
      </nav>

      <div class="mt-7 border-t border-[var(--border-subtle)] pt-5 space-y-4">
        <p class="text-sm font-semibold text-[var(--text-primary)]">Not sure where to start?</p>
        <p class="text-xs leading-relaxed text-[var(--text-muted)]">
          Speak with our team about Mathematics, Computer Science, or free Career Guidance.
        </p>
        <a
          href="https://wa.me/918011236456?text=Hi%20NPconscious%20team%2C%20I%27d%20like%20to%20talk%20about%20Mathematics%2C%20Computer%20Science%2C%20or%20free%20Career%20Guidance."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-pill-primary w-full !text-xs"
        >
          <span>Chat on WhatsApp</span>
        </a>

        <div class="pt-3 border-t border-[var(--border-subtle)] space-y-2 text-xs">
          <p class="text-xs font-semibold text-[var(--text-muted)]">Official Email Contacts</p>
          <!--email_off-->
          <div>
            <span class="text-xs text-[var(--text-muted)] block">Help &amp; Support</span>
            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=help@npconscious.com" target="_blank" rel="noopener noreferrer" class="text-[var(--text-primary)] hover:underline font-medium break-all">help@npconscious.com</a>
          </div>
          <div>
            <span class="text-xs text-[var(--text-muted)] block">Admissions</span>
            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=admission@npconscious.com" target="_blank" rel="noopener noreferrer" class="text-[var(--text-primary)] hover:underline font-medium break-all">admission@npconscious.com</a>
          </div>
          <div>
            <span class="text-xs text-[var(--text-muted)] block">Administration</span>
            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=admin@npconscious.com" target="_blank" rel="noopener noreferrer" class="text-[var(--text-primary)] hover:underline font-medium break-all">admin@npconscious.com</a>
          </div>
          <!--/email_off-->
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main id="main-content" aria-label="Main content" style="view-transition-name: main-content;">
      <slot />
    </main>

    <!-- Floating WhatsApp Action -->
    <aside aria-label="Contact via WhatsApp" class="fixed bottom-5 right-5 z-40" style="view-transition-name: floating-whatsapp;">
      <a
        href="https://wa.me/918011236456?text=Hi%20NPconscious%20team%2C%20I%27d%20like%20to%20talk%20about%20Mathematics%2C%20Computer%20Science%2C%20or%20free%20Career%20Guidance."
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat on WhatsApp with NPconscious"
        class="group flex h-12 w-12 items-center justify-center rounded-full bg-[var(--accent-sage)] text-white shadow-lg transition-all duration-150 hover:bg-[var(--accent-sage-hover)] hover:-translate-y-0.5 active:translate-y-0 md:h-auto md:w-auto md:px-4 md:py-3 md:gap-2"
      >
        <svg class="h-5 w-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        <span class="hidden md:inline text-sm font-medium pr-0.5">Chat on WhatsApp</span>
      </a>
    </aside>

    <!-- Footer -->
    <footer class="border-t border-[var(--border-subtle)] bg-white">
      <div class="px-5 pt-14 pb-24 lg:px-8 lg:pt-16 lg:pb-24">
        <div class="container-feature">
          <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_0.9fr_1.3fr] lg:gap-12">
            <!-- Column 1: Brand Info -->
            <div class="md:col-span-2 lg:col-span-1">
              <a
                href="/"
                class="footer-link inline-block rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent-sage)]"
                aria-label="NPconscious home"
              >
                <picture>
                  <source srcset="/site.webp" type="image/webp" />
                  <img
                    src="/site.png"
                    alt="NPconscious"
                    class="h-[38px] w-auto object-contain"
                    onerror="this.onerror=null; this.src='/site.png';"
                  />
                </picture>
              </a>
              <p class="mt-4 text-base font-semibold leading-snug text-[var(--text-primary)]">
                NPconscious: A Sanctuary for Young Minds
              </p>
              <p class="mt-2 max-w-[36ch] text-sm font-normal leading-6 text-[var(--text-secondary)]">
                Maths, Computer Science and free career guidance for CBSE, ICSE, IGCSE and IB students.
              </p>
            </div>

            <!-- Column 2: Explore -->
            <div>
              <p class="mb-4 text-xs font-bold uppercase tracking-[0.08em] text-[var(--accent-sage)]">
                Explore
              </p>
              <ul class="space-y-3 text-sm font-normal leading-6">
                <li>
                  <a
                    href="/"
                    class="footer-link rounded-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-sage)]"
                  >
                    Home
                  </a>
                </li>
                <li>
                  <a
                    href="/mathematics"
                    class="footer-link rounded-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-sage)]"
                  >
                    Mathematics
                  </a>
                </li>
                <li>
                  <a
                    href="/computer-science"
                    class="footer-link rounded-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-sage)]"
                  >
                    Computer Science
                  </a>
                </li>
                <li>
                  <a
                    href="/career-guidance"
                    class="footer-link inline-flex items-center gap-2 rounded-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-sage)]"
                  >
                    <span>Career Guidance</span>
                    <span class="inline-flex items-center rounded-full bg-[var(--accent-sage-soft)] px-2.5 py-0.5 text-xs font-semibold leading-none text-[var(--accent-sage-hover)]">
                      Free
                    </span>
                  </a>
                </li>
                <li>
                  <a
                    href="/founder"
                    class="footer-link rounded-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-sage)]"
                  >
                    Our Vision &amp; Philosophy
                  </a>
                </li>
                <li>
                  <a
                    href="/admission"
                    class="footer-link rounded-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-sage)]"
                  >
                    Admission
                  </a>
                </li>
              </ul>
            </div>

            <!-- Column 3: Direct Support -->
            <div>
              <p class="mb-4 text-xs font-bold uppercase tracking-[0.08em] text-[var(--accent-sage)]">
                Direct Support
              </p>

              <!-- Primary Phone & WhatsApp Icon Badges -->
              <div class="space-y-3">
                <a
                  href="tel:+918011236456"
                  class="group inline-flex w-full items-center gap-3 rounded-lg py-0.5 text-sm font-semibold text-[#1E293B] visited:text-[#1E293B] no-underline transition-colors hover:text-[var(--accent-sage)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-sage)]"
                >
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#F1F5F9] text-[#475569] transition-colors group-hover:bg-[#E2E8F0]" aria-hidden="true">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                  </span>
                  <span>+91 80112 36456</span>
                </a>

                <a
                  href="https://wa.me/918011236456"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex w-full items-center gap-3 rounded-lg py-0.5 text-sm font-medium text-[#1E293B] visited:text-[#1E293B] no-underline transition-colors hover:text-[var(--accent-sage)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-sage)]"
                >
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#ECFDF5] text-[#10B981] transition-colors group-hover:bg-[#D1FAE5]" aria-hidden="true">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                      <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21" />
                      <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1" />
                    </svg>
                  </span>
                  <span>WhatsApp Academic Support</span>
                </a>
              </div>

              <!-- Subtle Horizontal Divider -->
              <hr class="my-4 border-0 border-t border-[#E2E8F0]" />

              <!-- Stacked Two-Line Email Channels & Response Time Note -->
              <div>
                <!--email_off-->
                <div class="space-y-3.5">
                  {
                    directSupportEmails.map((item) => (
                      <div class="flex items-center gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#F1F5F9] text-[#475569]" aria-hidden="true">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <rect width="20" height="16" x="2" y="4" rx="2" />
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                          </svg>
                        </span>
                        <div class="min-w-0">
                          <span class="block text-[11px] font-semibold uppercase tracking-[0.05em] leading-tight text-[#94A3B8]">
                            {item.label}
                          </span>
                          <a
                            href={item.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-0.5 block rounded-sm text-[14px] font-medium leading-snug text-[#334155] visited:text-[#334155] no-underline transition-colors hover:text-[var(--accent-sage)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-sage)] break-words"
                          >
                            {item.email}
                          </a>
                        </div>
                      </div>
                    ))
                  }
                </div>
                <!--/email_off-->
