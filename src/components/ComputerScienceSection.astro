---
import ThinkingFlowCard from "./ThinkingFlowCard.astro";

const fillerContent = {
  eyebrowStatus: "Now enrolling · Ages 12-18", // FILLER
  eyebrowFees: "Course fees · from ₹X,XXX/month", // FILLER
  heading: "Computer Science",
  description:
    "Computer science and programming learning for students building practical technical thinking, structured logic, and foundational coding confidence.",
  highlights: [
    "Beginner Python & web basics", // FILLER
    "Small batches, live mentor-led sessions", // FILLER
    "Weekend and weekday slots", // FILLER
  ],
  ctaLabel: "View Computer Science", // FILLER
  ctaHref: "/computer-science",
};
---

<!-- Row 2: Computer Science (Copy Left, Interactive Thinking Flow Right) -->
<div class="grid gap-10 py-14 sm:py-20 lg:grid-cols-12 lg:items-center lg:gap-16 border-b border-[var(--border-subtle)]">
  <div class="min-w-0 space-y-5 lg:col-span-6" data-reveal>
    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
      <span class="text-[var(--accent-sage)]">{fillerContent.eyebrowStatus}</span>
      <span aria-hidden="true">·</span>
      <span>{fillerContent.eyebrowFees}</span>
    </div>

    <h3 class="section-h2 !text-3xl sm:!text-4xl">{fillerContent.heading}</h3>

    <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
      {fillerContent.description}
    </p>

    <ul class="space-y-2 border-t border-[var(--border-subtle)] pt-4 text-sm text-[var(--text-secondary)]">
      {
        fillerContent.highlights.map((item) => (
          <li class="flex items-center gap-2.5">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--text-primary)] shrink-0" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>

    <div class="pt-2">
      <a href={fillerContent.ctaHref} class="btn-pill-secondary">
        <span>{fillerContent.ctaLabel}</span>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>

  <div class="min-w-0 lg:col-span-6" data-reveal>
    <ThinkingFlowCard />
  </div>
</div>
