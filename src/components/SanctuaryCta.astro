---
interface Props {
  heading: string;
  description: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading,
  description,
  primaryLabel = "Book a Free Conversation",
  primaryHref = "https://wa.me/918011236456?text=Hi%20NPconscious%20team%2C%20I%27d%20like%20to%20talk%20about%20the%20right%20next%20step.",
  secondaryLabel = "Open Intake Form",
  secondaryHref = "/admission",
} = Astro.props;
---

<section class="surface-dark section-pad">
  <div class="container-reading text-center space-y-6">
    <h2 class="section-h2 !text-[#FAF8F4]">
      {heading}
    </h2>

    <p class="mx-auto max-w-xl text-sm sm:text-base leading-relaxed text-[#CFC9BE]">
      {description}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-1">
      <a
        href={primaryHref}
        target={primaryHref.startsWith("http") ? "_blank" : undefined}
        rel={primaryHref.startsWith("http") ? "noopener noreferrer" : undefined}
        class="inline-flex min-h-[46px] w-full sm:w-auto items-center justify-center gap-2 rounded-full bg-[#FAF8F4] px-7 py-3 text-sm font-semibold text-[#141414] shadow-[0_4px_0_0_#BEB7AA] transition-all duration-100 hover:translate-y-[1px] hover:shadow-[0_3px_0_0_#BEB7AA] active:translate-y-[3px] active:shadow-[0_1px_0_0_#BEB7AA]"
      >
        <span>{primaryLabel}</span>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href={secondaryHref}
        class="inline-flex min-h-[46px] w-full sm:w-auto items-center justify-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-3 text-sm font-medium text-[#FAF8F4] transition hover:bg-white/10"
      >
        <span>{secondaryLabel}</span>
      </a>
    </div>

    <div class="pt-4 border-t border-white/10 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-[#CFC9BE]">
      <!--email_off-->
      <a
        href="https://mail.google.com/mail/?view=cm&fs=1&to=help@npconscious.com"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-[#FAF8F4] underline underline-offset-4 hover:text-white"
      >
        help@npconscious.com
      </a>
      <!--/email_off-->
      <span aria-hidden="true">·</span>
      <a href="tel:+918011236456" class="font-medium text-[#FAF8F4] hover:underline">
        +91 80112 36456
      </a>
    </div>
  </div>
</section>
